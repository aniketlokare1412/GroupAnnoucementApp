<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    xmlns:h="clr-namespace:GroupAnnouncementApp.Helpers"
    x:Class="GroupAnnouncementApp.Controls.JoinGroupSection"
    x:DataType="vm:JoinGroupsViewModel">

    <!-- Member Home: type a group number, the matching group appears with a Join button. No group list. -->
    <VerticalStackLayout Spacing="8">

        <Label Style="{StaticResource SectionLabel}" Text="Join a group" />

        <Border Style="{StaticResource SearchBorder}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Grid.Column="0" Style="{StaticResource SearchIcon}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Search}" />
                <Entry
                    Grid.Column="1"
                    Style="{StaticResource SearchEntry}"
                    Placeholder="Enter group number"
                    Keyboard="Numeric"
                    ReturnType="Search"
                    Text="{Binding SearchText}"
                    SemanticProperties.Description="Group number" />
            </Grid>
        </Border>

        <Label Style="{StaticResource Caption}" Text="{Binding EmptyHint}" IsVisible="{Binding HasNoGroups}" />

        <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
            <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
        </Border>

        <Border Style="{StaticResource NoticeBanner}" IsVisible="{Binding HasNotice}">
            <Label Style="{StaticResource NoticeBannerText}" Text="{Binding NoticeMessage}" />
        </Border>

        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Groups}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:JoinGroupItem">
                                <Border
                                    Style="{StaticResource RowCard}"
                                    SemanticProperties.Description="{Binding CardLabel}"
                                    SemanticProperties.Hint="{Binding CardHint}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding PrimaryCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                                        <!-- Joined groups get the teal tint; others stay neutral -->
                                        <Border Grid.Column="0" Style="{StaticResource InitialsTile}" IsVisible="{Binding IsMember}">
                                            <Label Style="{StaticResource InitialsText}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding Initials}" />
                                        </Border>
                                        <Border Grid.Column="0" Style="{StaticResource InitialsTileMuted}" IsVisible="{Binding IsNotMember}">
                                            <Label Style="{StaticResource InitialsTextMuted}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding Initials}" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label
                                                Style="{StaticResource CardTitle}"
                                                Text="{Binding Name}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                            <Label
                                                Style="{StaticResource Caption}"
                                                Text="{Binding Description}"
                                                IsVisible="{Binding HasDescription}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                        </VerticalStackLayout>

                                        <Button
                                            Grid.Column="2"
                                            Style="{StaticResource IconButton}"
                                            Text="{x:Static h:Icons.Add}"
                                            Command="{Binding JoinCommand}"
                                            IsVisible="{Binding IsNotMember}"
                                            SemanticProperties.Description="{Binding JoinLabel}" />
                                        <Border
                                            Grid.Column="2"
                                            Style="{StaticResource BadgeSuccess}"
                                            IsVisible="{Binding IsMember}"
                                            VerticalOptions="Center"
                                            AutomationProperties.IsInAccessibleTree="False">
                                            <HorizontalStackLayout Spacing="3">
                                                <Label Style="{StaticResource ChipIcon}" Text="{x:Static h:Icons.Check}" />
                                                <Label Style="{StaticResource BadgeSuccessText}" Text="Joined" />
                                            </HorizontalStackLayout>
                                        </Border>

                                    </Grid>
                                </Border>
                            </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentView>
