<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GroupAnnouncementApp.Controls.ToastView"
    IsVisible="False"
    InputTransparent="True"
    HorizontalOptions="Center"
    VerticalOptions="End">

    <!-- Put one ToastView at the bottom of a page's root Grid (see HomePage). -->
    <Border Style="{StaticResource Toast}">
        <Label x:Name="MessageLabel" Style="{StaticResource ToastText}" />
    </Border>

</ContentView>
