<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ============ Soft teal theme tokens (Light / Dark pairs) ============
         Pages never use these directly: they use the named styles in Styles.xaml,
         which pick Light or Dark automatically with AppThemeBinding. -->

    <Color x:Key="BackgroundLight">#F6FAF9</Color>
    <Color x:Key="BackgroundDark">#0B1413</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#13201F</Color>
    <Color x:Key="SurfaceAltLight">#EEF4F3</Color>
    <Color x:Key="SurfaceAltDark">#1C2D2B</Color>
    <Color x:Key="BorderLight">#E3ECEA</Color>
    <Color x:Key="BorderDark">#25403D</Color>

    <Color x:Key="TextLight">#0F172A</Color>
    <Color x:Key="TextDark">#F1F5F9</Color>
    <Color x:Key="MutedLight">#64748B</Color>
    <Color x:Key="MutedDark">#94A3B8</Color>

    <Color x:Key="BrandLight">#0E8379</Color>
    <Color x:Key="BrandDark">#2DD4BF</Color>
    <!-- Deep teal: ONLY for small things (icons, initials). Never as a fill behind text. -->
    <Color x:Key="BrandDeepLight">#0F766E</Color>
    <Color x:Key="BrandDeepDark">#5EEAD4</Color>
    <Color x:Key="OnBrandLight">#FFFFFF</Color>
    <Color x:Key="OnBrandDark">#042F2E</Color>
    <Color x:Key="BrandTintLight">#E1F3F0</Color>
    <Color x:Key="BrandTintDark">#123F3B</Color>
    <Color x:Key="OnBrandTintLight">#0F766E</Color>
    <Color x:Key="OnBrandTintDark">#99F6E4</Color>

    <Color x:Key="SuccessTintLight">#D1FAE5</Color>
    <Color x:Key="SuccessTintDark">#064E3B</Color>
    <Color x:Key="OnSuccessLight">#065F46</Color>
    <Color x:Key="OnSuccessDark">#A7F3D0</Color>

    <Color x:Key="WarningTintLight">#FEF3C7</Color>
    <Color x:Key="WarningTintDark">#78350F</Color>
    <Color x:Key="OnWarningLight">#92400E</Color>
    <Color x:Key="OnWarningDark">#FDE68A</Color>

    <Color x:Key="DangerLight">#DC2626</Color>
    <Color x:Key="DangerDark">#F87171</Color>
    <Color x:Key="OnDangerFillLight">#FFFFFF</Color>
    <Color x:Key="OnDangerFillDark">#450A0A</Color>
    <Color x:Key="DangerTintLight">#FEE2E2</Color>
    <Color x:Key="DangerTintDark">#7F1D1D</Color>
    <Color x:Key="OnDangerLight">#991B1B</Color>
    <Color x:Key="OnDangerDark">#FECACA</Color>

    <!-- ============ Legacy keys, re-pointed to Teal so the standard styles keep working ============ -->

    <Color x:Key="Primary">#0F766E</Color>
    <Color x:Key="PrimaryDark">#2DD4BF</Color>
    <Color x:Key="PrimaryDarkText">#042F2E</Color>
    <Color x:Key="Secondary">#CCFBF1</Color>
    <Color x:Key="SecondaryDarkText">#99F6E4</Color>
    <Color x:Key="Tertiary">#134E4A</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
