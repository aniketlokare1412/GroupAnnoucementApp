<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ============ "Power Grid" theme tokens (Light / Dark pairs) ============
         Blue = brand and actions. Status carries colour: red = work in progress, amber = planned / time up,
         green = completed / restored, violet = groups and counts.
         Pages never use these directly: they use the named styles in Styles.xaml / ThemeExtras.xaml,
         which pick Light or Dark automatically with AppThemeBinding. -->

    <Color x:Key="BackgroundLight">#F4F7FB</Color>
    <Color x:Key="BackgroundDark">#0B1220</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#131C2E</Color>
    <Color x:Key="SurfaceAltLight">#EAF0F8</Color>
    <Color x:Key="SurfaceAltDark">#1C2740</Color>
    <Color x:Key="BorderLight">#DDE6F1</Color>
    <Color x:Key="BorderDark">#26334F</Color>

    <Color x:Key="TextLight">#0F172A</Color>
    <Color x:Key="TextDark">#F1F5F9</Color>
    <Color x:Key="MutedLight">#64748B</Color>
    <Color x:Key="MutedDark">#94A3B8</Color>

    <!-- Electric blue: brand and actions -->
    <Color x:Key="BrandLight">#2563EB</Color>
    <Color x:Key="BrandDark">#60A5FA</Color>
    <!-- Deep blue: ONLY for small things (icons, initials). Never as a fill behind text. -->
    <Color x:Key="BrandDeepLight">#1D4ED8</Color>
    <Color x:Key="BrandDeepDark">#93C5FD</Color>
    <Color x:Key="OnBrandLight">#FFFFFF</Color>
    <Color x:Key="OnBrandDark">#0B1220</Color>
    <Color x:Key="BrandTintLight">#DBEAFE</Color>
    <Color x:Key="BrandTintDark">#1E3A8A</Color>
    <Color x:Key="OnBrandTintLight">#1D4ED8</Color>
    <Color x:Key="OnBrandTintDark">#BFDBFE</Color>

    <!-- Violet: groups and counts -->
    <Color x:Key="VioletLight">#7C3AED</Color>
    <Color x:Key="VioletDark">#A78BFA</Color>
    <Color x:Key="VioletTintLight">#EDE9FE</Color>
    <Color x:Key="VioletTintDark">#3B2670</Color>
    <Color x:Key="OnVioletTintLight">#5B21B6</Color>
    <Color x:Key="OnVioletTintDark">#DDD6FE</Color>

    <!-- Amber: planned outage, time up -->
    <Color x:Key="AmberLight">#F59E0B</Color>
    <Color x:Key="AmberDark">#FBBF24</Color>

    <!-- Green: completed / restored -->
    <Color x:Key="GreenLight">#16A34A</Color>
    <Color x:Key="GreenDark">#4ADE80</Color>

    <Color x:Key="SuccessTintLight">#D1FAE5</Color>
    <Color x:Key="SuccessTintDark">#064E3B</Color>
    <Color x:Key="OnSuccessLight">#065F46</Color>
    <Color x:Key="OnSuccessDark">#A7F3D0</Color>

    <Color x:Key="WarningTintLight">#FEF3C7</Color>
    <Color x:Key="WarningTintDark">#78350F</Color>
    <Color x:Key="OnWarningLight">#92400E</Color>
    <Color x:Key="OnWarningDark">#FDE68A</Color>

    <Color x:Key="DangerLight">#DC2626</Color>
    <Color x:Key="DangerDark">#F87171</Color>
    <Color x:Key="OnDangerFillLight">#FFFFFF</Color>
    <Color x:Key="OnDangerFillDark">#450A0A</Color>
    <Color x:Key="DangerTintLight">#FEE2E2</Color>
    <Color x:Key="DangerTintDark">#7F1D1D</Color>
    <Color x:Key="OnDangerLight">#991B1B</Color>
    <Color x:Key="OnDangerDark">#FECACA</Color>

    <!-- ============ Legacy keys, re-pointed to the blue brand so the standard styles keep working ============ -->

    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="PrimaryDark">#60A5FA</Color>
    <Color x:Key="PrimaryDarkText">#0B1220</Color>
    <Color x:Key="Secondary">#DBEAFE</Color>
    <Color x:Key="SecondaryDarkText">#BFDBFE</Color>
    <Color x:Key="Tertiary">#1E3A8A</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
