        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Cards -->
    <Style TargetType="Border" x:Key="RowCard" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
    </Style>

    <Style TargetType="Border" x:Key="CardDashed" BasedOn="{StaticResource RowCard}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>

    <!-- Rounded-square icon holder (36) and group initials holder (44). -->
    <Style TargetType="Border" x:Key="IconTile">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandTintLight}, Dark={StaticResource BrandTintDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style TargetType="Border" x:Key="InitialsTile" BasedOn="{StaticResource IconTile}">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Border" x:Key="InitialsTileMuted" BasedOn="{StaticResource InitialsTile}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="InitialsText">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
