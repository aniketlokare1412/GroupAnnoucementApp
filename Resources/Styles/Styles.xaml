    <Style TargetType="Label" x:Key="QuickActionLabel" BasedOn="{StaticResource Caption}">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Toast: inverse surface (dark on light theme, light on dark theme). No new colors. -->
    <Style TargetType="Border" x:Key="Toast">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="20,0,20,16" />
    </Style>

    <Style TargetType="Label" x:Key="ToastText">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundDark}}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- ================================================================== -->
    <!--  Phase B: Discover and announcements feed                          -->
    <!-- ================================================================== -->

    <!-- Message text inside an announcement card. -->
    <Style TargetType="Label" x:Key="BodyText">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    </Style>

    <!-- Soft warning banner (not an error): a Border (NoticeBanner) holding a Label (NoticeBannerText). -->
    <Style TargetType="Border" x:Key="NoticeBanner">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarningTintLight}, Dark={StaticResource WarningTintDark}}" />
