<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- "Aurora" theme, Phase 1: gradient and 3D styles. Loaded last (see App.xaml). -->

    <!-- ===== Home hero banner: gradient, soft glow, white text ===== -->
    <Style TargetType="Border" x:Key="HeroBanner">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource HeroGradLight}, Dark={StaticResource HeroGradDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#2E2A9E" Opacity="0.32" Radius="18" Offset="0,8" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Label" x:Key="HeroGreeting">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="#E6FFFFFF" />
    </Style>
    <Style TargetType="Label" x:Key="HeroTitle">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="#FFFFFF" />
    </Style>
    <Style TargetType="Button" x:Key="AvatarOnHero">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="BackgroundColor" Value="#33FFFFFF" />
        <Setter Property="BorderColor" Value="#66FFFFFF" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="42" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="MinimumWidthRequest" Value="42" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ===== Gradient feature tiles (40x40, coloured glow). Use with a colour emoji inside. ===== -->
    <Style TargetType="Border" x:Key="GradTileBlue" BasedOn="{StaticResource IconTileBlue}">
        <Setter Property="Background" Value="{StaticResource TileBlueGrad}" />
    </Style>
    <Style TargetType="Border" x:Key="GradTileTeal" BasedOn="{StaticResource IconTileBlue}">
        <Setter Property="Background" Value="{StaticResource TileTealGrad}" />
    </Style>
    <Style TargetType="Border" x:Key="GradTileViolet" BasedOn="{StaticResource IconTileBlue}">
        <Setter Property="Background" Value="{StaticResource TileVioletGrad}" />
    </Style>
    <Style TargetType="Border" x:Key="GradTilePink" BasedOn="{StaticResource IconTileBlue}">
        <Setter Property="Background" Value="{StaticResource TilePinkGrad}" />
    </Style>
    <Style TargetType="Border" x:Key="GradTileCoral" BasedOn="{StaticResource IconTileBlue}">
        <Setter Property="Background" Value="{StaticResource TileCoralGrad}" />
    </Style>
    <Style TargetType="Border" x:Key="GradTileAmber" BasedOn="{StaticResource IconTileBlue}">
        <Setter Property="Background" Value="{StaticResource TileAmberGrad}" />
    </Style>
    <Style TargetType="Border" x:Key="GradTileLime" BasedOn="{StaticResource IconTileBlue}">
        <Setter Property="Background" Value="{StaticResource TileLimeGrad}" />
    </Style>

    <!-- ===== Round quick-action buttons: gradient + coloured glow ===== -->
    <Style TargetType="Button" x:Key="QuickActionBlue" BasedOn="{StaticResource EmojiButton}">
        <Setter Property="Background" Value="{StaticResource TileBlueGrad}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#2563EB" Opacity="0.22" Radius="10" Offset="0,4" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="QuickActionTeal" BasedOn="{StaticResource EmojiButton}">
        <Setter Property="Background" Value="{StaticResource TileTealGrad}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#0E8379" Opacity="0.22" Radius="10" Offset="0,4" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="QuickActionCoral" BasedOn="{StaticResource EmojiButton}">
        <Setter Property="Background" Value="{StaticResource TileCoralGrad}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#E5484D" Opacity="0.22" Radius="10" Offset="0,4" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Segmented switcher (Groups | Communities | Super). One row, equal widths, never wraps. ===== -->
    <Style TargetType="Border" x:Key="SegmentTrack">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style TargetType="Border" x:Key="SegmentChip">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 17" />
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style TargetType="Border" x:Key="SegmentChipOn" BasedOn="{StaticResource SegmentChip}">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource BrandGradLight}, Dark={StaticResource BrandGradDark}}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#3A6FE0" Opacity="0.16" Radius="6" Offset="0,2" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Label" x:Key="SegmentText">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>
    <Style TargetType="Label" x:Key="SegmentTextOn" BasedOn="{StaticResource SegmentText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnBrandLight}, Dark={StaticResource OnBrandDark}}" />
    </Style>

</ResourceDictionary>
