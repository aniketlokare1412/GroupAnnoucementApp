<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    xmlns:h="clr-namespace:GroupAnnouncementApp.Helpers"
    xmlns:controls="clr-namespace:GroupAnnouncementApp.Controls"
    x:Class="GroupAnnouncementApp.Views.AnnouncementEditPage"
    x:DataType="vm:AnnouncementEditViewModel"
    Title="{Binding TitleText}">

    <!-- Admin composer: new post (one group, or several groups), or edit a post.
         One fixed page, no scrolling: title, message (takes the free height), group search,
         group pills, then the one main button pinned to the bottom. Cancel = the back arrow. -->
    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,*" RowSpacing="14" Padding="16,12,16,8">

            <!-- 1. Title -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto">

                <!-- Labels -->
                <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Title" />
                    <Label
                        Grid.Column="1"
                        Style="{StaticResource Caption}"
                        Text="{Binding TitleCountText}"
                        IsVisible="{Binding ShowTitleEntry}"
                        AutomationProperties.IsInAccessibleTree="False" />
                </Grid>
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource FieldLabel}"
                    Text="Resolution time"
                    IsVisible="{Binding IsNewPost}" />

                <!-- New post: choose a ready-made title (the last choice is a custom announcement) -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldBorder}" IsVisible="{Binding IsNewPost}" Margin="0,6,0,0">
                    <Picker
                        Title="Choose a title"
                        ItemsSource="{Binding TemplateTitles}"
                        SelectedIndex="{Binding TemplateIndex}"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="Announcement title" />
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBorder}" IsVisible="{Binding IsNewPost}" WidthRequest="140" Margin="0,6,0,0">
                    <Picker
                        Title="Not set"
                        ItemsSource="{Binding TimeOptions}"
                        SelectedIndex="{Binding TimeIndex}"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="Resolution time" />
                </Border>

                <!-- Custom announcement (or editing): the title is typed -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource FieldBorder}" IsVisible="{Binding ShowTitleEntry}" Margin="0,6,0,0">
                    <Entry
                        Placeholder="Announcement title"
                        ReturnType="Next"
                        Text="{Binding Title}"
                        MaxLength="{Binding MaxTitleLength}"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="Announcement title" />
                </Border>

                <!-- Custom resolution time -->
                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource FieldBorder}" IsVisible="{Binding ShowCustomTime}" Margin="0,6,0,0">
                    <Entry
                        Placeholder="Resolution time as HH:MM, e.g. 01:15"
                        ReturnType="Done"
                        Text="{Binding CustomTime}"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="Custom resolution time, hours and minutes" />
                </Border>
            </Grid>

            <!-- 2. Message: fills whatever height is left -->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Message" />
                    <Label
                        Grid.Column="1"
                        Style="{StaticResource Caption}"
                        Text="{Binding MessageCountText}"
                        AutomationProperties.IsInAccessibleTree="False" />
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource FieldBorder}" Padding="10,6" HeightRequest="{Binding MessageBoxHeight}">
                    <Editor
                        Placeholder="Choose a title to see the message"
                        IsReadOnly="{Binding IsMessageReadOnly}"
                        Text="{Binding Message}"
                        MaxLength="{Binding MaxMessageLength}"
                        AutoSize="Disabled"
                        VerticalOptions="Fill"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="Announcement message" />
                </Border>
                <!-- Optional attachment: one image or document, up to 10 MB -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding CanAttach}">
                    <Button
                        Grid.Column="0"
                        Style="{StaticResource IconButton}"
                        Text="{x:Static h:Icons.AttachFile}"
                        Command="{Binding PickAttachmentCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="Attach an image or document"
                        SemanticProperties.Hint="Optional. One file. Photos are made smaller automatically; documents can be up to 700 kilobytes" />
                    <Label
                        Grid.Column="1"
                        Style="{StaticResource Caption}"
                        Text="{Binding AttachmentSummary}"
                        VerticalOptions="Center"
                        LineBreakMode="MiddleTruncation"
                        MaxLines="1" />
                    <Button
                        Grid.Column="2"
                        Style="{StaticResource IconButtonPlain}"
                        Text="{x:Static h:Icons.Close}"
                        Command="{Binding ClearAttachmentCommand}"
                        IsVisible="{Binding HasAttachment}"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="Remove the attachment" />
                </Grid>

                <!-- Edit mode: the post is still loading -->
                <ActivityIndicator
                    Grid.Row="1"
                    IsRunning="{Binding ShowEditSpinner}"
                    IsVisible="{Binding ShowEditSpinner}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

            <!-- 3. Where it goes -->
            <VerticalStackLayout Grid.Row="2" Spacing="10">

                <!-- One group, or editing: just say which group -->
                <Border Style="{StaticResource RowCard}" IsVisible="{Binding HasTarget}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource InitialsTile}">
                            <Label Style="{StaticResource InitialsText}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding TargetInitials}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Style="{StaticResource Caption}" Text="{Binding TargetCaption}" />
                            <Label
                                Style="{StaticResource CardTitle}"
                                Text="{Binding TargetName}"
                                LineBreakMode="TailTruncation"
                                MaxLines="1" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Several groups: one line with the count; tap it to open the full picker
                     (search, communities, super communities). Fine for hundreds of groups. -->
                <Border
                    Style="{StaticResource RowCard}"
                    IsVisible="{Binding IsPickerVisible}"
                    SemanticProperties.Description="{Binding SelectedCountText}"
                    SemanticProperties.Hint="Opens the group picker">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChooseGroupsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource IconTileBlue}" VerticalOptions="Center">
                            <Label Style="{StaticResource Icon}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Group}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Style="{StaticResource CardTitle}" Text="{Binding SelectedCountText}" />
                            <Label Style="{StaticResource Caption}" Text="Tap to choose groups, communities or super communities" LineBreakMode="TailTruncation" MaxLines="1" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Style="{StaticResource IconMuted}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.ChevronRight}" />
                    </Grid>
                </Border>

            </VerticalStackLayout>

        </Grid>

        <!-- Bottom bar: messages, then the one main button -->
        <VerticalStackLayout Grid.Row="1" Spacing="0">
            <BoxView Style="{StaticResource Hairline}" />
            <VerticalStackLayout Padding="16,8,16,12" Spacing="8">

                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
                </Border>

                <Border Style="{StaticResource NoticeBanner}" IsVisible="{Binding HasNotice}">
                    <Label Style="{StaticResource NoticeBannerText}" Text="{Binding NoticeMessage}" />
                </Border>

                <Button
                    Style="{StaticResource LinkButton}"
                    Text="Try again"
                    Command="{Binding RetryCommand}"
                    IsVisible="{Binding ShowRetry}"
                    IsEnabled="{Binding IsNotBusy}"
                    HorizontalOptions="Center" />

                <Button
                    Style="{StaticResource PillPrimary}"
                    Text="{Binding PrimaryButtonText}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    HorizontalOptions="Fill" />

            </VerticalStackLayout>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
