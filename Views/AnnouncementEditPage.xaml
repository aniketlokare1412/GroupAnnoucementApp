<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    xmlns:h="clr-namespace:GroupAnnouncementApp.Helpers"
    xmlns:controls="clr-namespace:GroupAnnouncementApp.Controls"
    x:Class="GroupAnnouncementApp.Views.AnnouncementEditPage"
    x:DataType="vm:AnnouncementEditViewModel"
    Title="{Binding TitleText}">

    <!-- Admin composer: new post (one group, or several groups), or edit a post.
         One fixed page, no scrolling: title, message (takes the free height), group search,
         group pills, then the one main button pinned to the bottom. Cancel = the back arrow. -->
    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0" RowDefinitions="Auto,*,Auto" RowSpacing="14" Padding="16,12,16,8">

            <!-- 1. Title -->
            <VerticalStackLayout Grid.Row="0" Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Title" />
                    <Label
                        Grid.Column="1"
                        Style="{StaticResource Caption}"
                        Text="{Binding TitleCountText}"
                        AutomationProperties.IsInAccessibleTree="False" />
                </Grid>
                <Border Style="{StaticResource FieldBorder}">
                    <Entry
                        Placeholder="Announcement title"
                        ReturnType="Next"
                        Text="{Binding Title}"
                        MaxLength="{Binding MaxTitleLength}"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="Announcement title" />
                </Border>
            </VerticalStackLayout>

            <!-- 2. Message: fills whatever height is left -->
            <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="6">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Message" />
                    <Label
                        Grid.Column="1"
                        Style="{StaticResource Caption}"
                        Text="{Binding MessageCountText}"
                        AutomationProperties.IsInAccessibleTree="False" />
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource FieldBorder}" Padding="10,6" MinimumHeightRequest="96">
                    <Editor
                        Placeholder="Write your announcement"
                        Text="{Binding Message}"
                        MaxLength="{Binding MaxMessageLength}"
                        AutoSize="Disabled"
                        VerticalOptions="Fill"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="Announcement message" />
                </Border>
                <!-- Edit mode: the post is still loading -->
                <ActivityIndicator
                    Grid.Row="1"
                    IsRunning="{Binding ShowEditSpinner}"
                    IsVisible="{Binding ShowEditSpinner}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

            <!-- 3. Where it goes -->
            <VerticalStackLayout Grid.Row="2" Spacing="10">

                <!-- One group, or editing: just say which group -->
                <Border Style="{StaticResource RowCard}" IsVisible="{Binding HasTarget}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource InitialsTile}">
                            <Label Style="{StaticResource InitialsText}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding TargetInitials}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Style="{StaticResource Caption}" Text="{Binding TargetCaption}" />
                            <Label
                                Style="{StaticResource CardTitle}"
                                Text="{Binding TargetName}"
                                LineBreakMode="TailTruncation"
                                MaxLines="1" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Several groups: search, count, then small pills to tap -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsPickerVisible}">

                    <Border Style="{StaticResource SearchBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Style="{StaticResource SearchIcon}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Search}" />
                            <Entry
                                Grid.Column="1"
                                Style="{StaticResource SearchEntry}"
                                Placeholder="Search groups"
                                ReturnType="Search"
                                Text="{Binding SearchText}"
                                SemanticProperties.Description="Search groups" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Border Grid.Column="0" Style="{StaticResource BadgeNeutral}" IsVisible="{Binding HasNoSelection}">
                            <Label Style="{StaticResource BadgeNeutralText}" Text="{Binding SelectedCountText}" />
                        </Border>
                        <Border Grid.Column="0" Style="{StaticResource BadgeBrand}" IsVisible="{Binding HasSelection}">
                            <Label Style="{StaticResource BadgeBrandText}" Text="{Binding SelectedCountText}" />
                        </Border>
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource LinkButton}"
                            Text="Select all"
                            Command="{Binding SelectAllCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Hint="Ticks every group shown below" />
                        <Button
                            Grid.Column="2"
                            Style="{StaticResource LinkButton}"
                            Text="Clear"
                            Command="{Binding ClearSelectionCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Hint="Unticks all groups" />
                    </Grid>

                    <!-- Fixed-height pill area (about three rows). If there are very many groups, only this area scrolls. -->
                    <Grid HeightRequest="124">

                        <ScrollView VerticalScrollBarVisibility="Never">
                            <FlexLayout
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignItems="Start"
                                AlignContent="Start"
                                IsEnabled="{Binding IsNotBusy}"
                                BindableLayout.ItemsSource="{Binding Groups}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SelectableGroupItem">
                                        <Grid
                                            Margin="0,0,8,8"
                                            SemanticProperties.Description="{Binding CardLabel}"
                                            SemanticProperties.Hint="Double tap to select or unselect">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                            </Grid.GestureRecognizers>

                                            <Border Style="{StaticResource GroupPill}" IsVisible="{Binding IsNotSelected}">
                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                    <Label Style="{StaticResource PillAdd}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Add}" />
                                                    <Label Style="{StaticResource GroupPillText}" Text="{Binding Name}" MaximumWidthRequest="200" />
                                                </HorizontalStackLayout>
                                            </Border>

                                            <Border Style="{StaticResource GroupPillOn}" IsVisible="{Binding IsSelected}">
                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                    <Label Style="{StaticResource PillCheck}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Check}" />
                                                    <Label Style="{StaticResource GroupPillTextOn}" Text="{Binding Name}" MaximumWidthRequest="200" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </ScrollView>

                        <!-- First load -->
                        <controls:SkeletonList Kind="Pills" IsVisible="{Binding ShowPickerSkeleton}" VerticalOptions="Start" />

                        <!-- No (matching) active groups -->
                        <VerticalStackLayout
                            IsVisible="{Binding HasNoGroups}"
                            Spacing="4"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">
                            <Label Style="{StaticResource CardTitle}" Text="No active groups" HorizontalOptions="Center" />
                            <Label
                                Style="{StaticResource Caption}"
                                Text="Create or activate a group first, or change your search."
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </Grid>

        <!-- Bottom bar: messages, then the one main button -->
        <VerticalStackLayout Grid.Row="1" Spacing="0">
            <BoxView Style="{StaticResource Hairline}" />
            <VerticalStackLayout Padding="16,8,16,12" Spacing="8">

                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
                </Border>

                <Border Style="{StaticResource NoticeBanner}" IsVisible="{Binding HasNotice}">
                    <Label Style="{StaticResource NoticeBannerText}" Text="{Binding NoticeMessage}" />
                </Border>

                <Button
                    Style="{StaticResource LinkButton}"
                    Text="Try again"
                    Command="{Binding RetryCommand}"
                    IsVisible="{Binding ShowRetry}"
                    IsEnabled="{Binding IsNotBusy}"
                    HorizontalOptions="Center" />

                <Button
                    Style="{StaticResource PillPrimary}"
                    Text="{Binding PrimaryButtonText}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    HorizontalOptions="Fill" />

            </VerticalStackLayout>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
