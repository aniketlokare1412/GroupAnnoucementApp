<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    x:Class="GroupAnnouncementApp.Views.AnnouncementGroupsPage"
    x:DataType="vm:AnnouncementGroupsViewModel"
    Title="DTC announcements">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="8">

        <SearchBar
            Grid.Row="0"
            Placeholder="Search DTCs"
            Text="{Binding SearchText}" />

        <Label Grid.Row="1" Text="Tap a DTC to see and manage its announcements." Style="{StaticResource Caption}" />

        <Label
            Grid.Row="2"
            Text="{Binding ErrorMessage}"
            IsVisible="{Binding HasError}"
            Style="{StaticResource ErrorText}" />

        <Grid Grid.Row="3">

            <CollectionView
                ItemsSource="{Binding Groups}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedGroup}"
                IsEnabled="{Binding IsNotBusy}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupListItem">
                        <VerticalStackLayout Padding="8,10" Spacing="2">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="Inactive DTC" Style="{StaticResource ErrorText}" IsVisible="{Binding IsInactive}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                Text="No DTCs found."
                IsVisible="{Binding HasNoGroups}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        </Grid>

        <Button
                Style="{StaticResource GradientButton}"
            Grid.Row="4"
            Text="Refresh"
            Command="{Binding RefreshCommand}"
            IsEnabled="{Binding IsNotBusy}" />

    </Grid>
</ContentPage>
