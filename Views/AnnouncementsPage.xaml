<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    xmlns:h="clr-namespace:GroupAnnouncementApp.Helpers"
    xmlns:controls="clr-namespace:GroupAnnouncementApp.Controls"
    x:Class="GroupAnnouncementApp.Views.AnnouncementsPage"
    x:DataType="vm:AnnouncementsViewModel"
    Title="Announcements">

    <!-- Announcements of one group. Members see a feed of cards and a leave icon.
         Admins see the same cards plus edit / delete icons and the one text button, "New post". -->
    <Grid>

        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- Header: group initials, name, count, and the page action -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="16,10,16,6">
                <Border Grid.Column="0" Style="{StaticResource InitialsTile}">
                    <Label Style="{StaticResource InitialsText}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding Initials}" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label
                        Style="{StaticResource SectionTitle}"
                        Text="{Binding GroupName}"
                        LineBreakMode="TailTruncation"
                        MaxLines="1" />
                    <Label Style="{StaticResource Caption}" Text="{Binding CountText}" />
                </VerticalStackLayout>

                <!-- Admin: the one main action on this screen -->
                <Button
                    Grid.Column="2"
                    Style="{StaticResource PillPrimary}"
                    Text="New post"
                    Command="{Binding NewCommand}"
                    IsVisible="{Binding IsAdminView}"
                    IsEnabled="{Binding IsNotBusy}"
                    VerticalOptions="Center"
                    SemanticProperties.Hint="Write an announcement for this group" />

                <!-- Member: leave this group -->
                <Button
                    Grid.Column="2"
                    Style="{StaticResource IconButton}"
                    Text="{x:Static h:Icons.Logout}"
                    Command="{Binding LeaveGroupCommand}"
                    IsVisible="{Binding IsMemberView}"
                    IsEnabled="{Binding IsNotBusy}"
                    SemanticProperties.Description="Leave group"
                    SemanticProperties.Hint="You will stop seeing this group's announcements" />
            </Grid>

            <Border
                Grid.Row="1"
                Style="{StaticResource ErrorBanner}"
                Margin="16,0,16,6"
                IsVisible="{Binding HasError}">
                <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
            </Border>

            <!-- Feed -->
            <Grid Grid.Row="2">

                <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                    <CollectionView
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        Margin="16,0">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnnouncementListItem">
                                <Border Style="{StaticResource Card}" Opacity="{Binding CardOpacity}">
                                    <VerticalStackLayout Spacing="4">

                                        <!-- Chips: New, Edited, Deleted -->
                                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasBadges}">
                                            <Border Style="{StaticResource BadgeBrand}" IsVisible="{Binding IsNew}">
                                                <Label Style="{StaticResource BadgeBrandText}" Text="New" />
                                            </Border>
                                            <Border Style="{StaticResource BadgeNeutral}" IsVisible="{Binding IsEdited}">
                                                <Label Style="{StaticResource BadgeNeutralText}" Text="Edited" />
                                            </Border>
                                            <Border Style="{StaticResource BadgeDanger}" IsVisible="{Binding IsDeleted}">
                                                <Label Style="{StaticResource BadgeDangerText}" Text="Deleted" />
                                            </Border>
                                            <Border Style="{StaticResource BadgeNeutral}" IsVisible="{Binding IsByOtherAdmin}">
                                                <Label Style="{StaticResource BadgeNeutralText}" Text="Another admin" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Label Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                                        <Label Style="{StaticResource BodyText}" Text="{Binding Message}" />
                                        <Image
                                            Source="{Binding Image}"
                                            IsVisible="{Binding HasImage}"
                                            Aspect="AspectFit"
                                            MaximumHeightRequest="240"
                                            HorizontalOptions="Fill"
                                            SemanticProperties.Description="Attached image" />
                                        <Border
                                            Style="{StaticResource RowCard}"
                                            IsVisible="{Binding HasFile}"
                                            SemanticProperties.Description="{Binding FileLabel}"
                                            SemanticProperties.Hint="Opens the file">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenFileCommand}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Label Grid.Column="0" Style="{StaticResource Icon}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.File}" />
                                                <Label Grid.Column="1" Style="{StaticResource CardTitle}" Text="{Binding FileName}" VerticalOptions="Center" LineBreakMode="MiddleTruncation" MaxLines="1" />
                                            </Grid>
                                        </Border>
                                        <HorizontalStackLayout Spacing="8">
                                            <Border Style="{StaticResource BadgeDanger}" IsVisible="{Binding Extras.IsActive}" Padding="10,4">
                                                <HorizontalStackLayout Spacing="8">
                                                    <controls:BlinkingDot IsVisible="{Binding Extras.IsActive}" VerticalOptions="Center" />
                                                    <Label Style="{StaticResource BadgeDangerText}" Text="Work in progress" />
                                                </HorizontalStackLayout>
                                            </Border>
                                            <Border Style="{StaticResource BadgeSuccess}" IsVisible="{Binding Extras.IsCompleted}" Padding="10,4">
                                                <Label Style="{StaticResource BadgeSuccessText}" Text="{Binding Extras.CompletedText}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding Extras.ShowTimer}">
                                            <Label Style="{StaticResource Icon}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Schedule}" />
                                            <Label Style="{StaticResource BodyText}" Text="Time left" VerticalOptions="Center" />
                                            <Label Style="{StaticResource AnnouncementTitle}" Text="{Binding Extras.TimeLeftText}" VerticalOptions="Center" SemanticProperties.Description="Time left" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding Extras.ShowTimeUp}">
                                            <Label Style="{StaticResource ErrorText}" FontFamily="OpenSansSemibold" Text="Time is up" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Style="{StaticResource Caption}" Text="{Binding Extras.ResolutionText}" IsVisible="{Binding Extras.HasResolution}" />

                                        <!-- Members: the panic button -->
                                        <Button
                                            Style="{StaticResource PanicButton}"
                                            Text="{Binding Extras.PanicText}"
                                            Command="{Binding Extras.PressPanicCommand}"
                                            IsEnabled="{Binding Extras.CanPressPanic}"
                                            IsVisible="{Binding Extras.ShowPanic}"
                                            SemanticProperties.Hint="Reports that the problem is still not solved. Works once, when the time is up or the work is completed" />

                                        <!-- Admins: the panic count (highlighted when someone pressed) and Mark completed -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Extras.ShowAdminTools}">
                                            <Border Grid.Column="0" Style="{StaticResource BadgeDanger}" IsVisible="{Binding Extras.HasPanic}" Padding="12,6">
                                                <Label Style="{StaticResource BadgeDangerText}" FontSize="17" Text="{Binding Extras.PanicCountText}" />
                                            </Border>
                                            <Label Grid.Column="0" Style="{StaticResource Caption}" Text="{Binding Extras.PanicCountText}" IsVisible="{Binding Extras.HasNoPanic}" VerticalOptions="Center" />
                                            <Button
                                                Grid.Column="1"
                                                Style="{StaticResource PillTonal}"
                                                Text="Mark completed"
                                                Command="{Binding Extras.CompleteCommand}"
                                                IsVisible="{Binding Extras.CanMarkCompleted}"
                                                SemanticProperties.Hint="Marks the work as completed and lets members report problems" />
                                        </Grid>

                                        <!-- Footer: date, and (admin, own posts) edit / delete icons -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                            <Label
                                                Grid.Column="0"
                                                Style="{StaticResource Caption}"
                                                Text="{Binding DateText}"
                                                VerticalOptions="Center" />
                                            <HorizontalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding CanManage}">
                                                <Button
                                                    Style="{StaticResource IconButton}"
                                                    Text="{x:Static h:Icons.Edit}"
                                                    Command="{Binding EditCommand}"
                                                    SemanticProperties.Description="{Binding EditLabel}" />
                                                <Button
                                                    Style="{StaticResource IconButtonDanger}"
                                                    Text="{x:Static h:Icons.Delete}"
                                                    Command="{Binding DeleteCommand}"
                                                    SemanticProperties.Description="{Binding DeleteLabel}" />
                                            </HorizontalStackLayout>
                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <Grid HeightRequest="12" />
                        </CollectionView.Footer>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout
                                x:DataType="vm:AnnouncementsViewModel"
                                IsVisible="{Binding HasNoItems}"
                                Spacing="8"
                                Padding="0,40,0,0"
                                HorizontalOptions="Center">
                                <Border Style="{StaticResource EmptyIconTile}">
                                    <Label Style="{StaticResource EmptyIcon}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Campaign}" />
                                </Border>
                                <Label Style="{StaticResource CardTitle}" Text="No announcements yet" HorizontalOptions="Center" />
                                <Label
                                    Style="{StaticResource Caption}"
                                    Text="{Binding EmptyHint}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </RefreshView>

                <controls:SkeletonList Kind="Post" IsVisible="{Binding ShowLoading}" VerticalOptions="Start" Margin="16,0" />

            </Grid>

            <Button
                Grid.Row="3"
                Style="{StaticResource PillTonal}"
                Text="Load more"
                Command="{Binding LoadMoreCommand}"
                IsVisible="{Binding HasMore}"
                IsEnabled="{Binding IsNotBusy}"
                HorizontalOptions="Center"
                Margin="0,4,0,16" />

        </Grid>

        <controls:ToastView x:Name="Toast" />

    </Grid>
</ContentPage>
