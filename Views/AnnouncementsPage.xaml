<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    xmlns:h="clr-namespace:GroupAnnouncementApp.Helpers"
    xmlns:controls="clr-namespace:GroupAnnouncementApp.Controls"
    x:Class="GroupAnnouncementApp.Views.AnnouncementsPage"
    x:DataType="vm:AnnouncementsViewModel"
    Title="Announcements">

    <!-- Announcements of one group. Members see a feed of cards and a leave icon.
         Admins see the same cards plus a delete icon and the one text button, "New post". -->
    <Grid>

        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- Header: group initials, name, count, and the page action -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="16,10,16,6">
                <Border Grid.Column="0" Style="{StaticResource InitialsTile}" BackgroundColor="{Binding TileBackground}">
                    <Label Style="{StaticResource InitialsText}" TextColor="{Binding TileForeground}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding Initials}" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label
                        Style="{StaticResource SectionTitle}"
                        Text="{Binding GroupName}"
                        LineBreakMode="TailTruncation"
                        MaxLines="1" />
                    <Label Style="{StaticResource Caption}" Text="{Binding CountText}" />
                </VerticalStackLayout>

                <!-- Admin: the one main action on this screen -->
                <Button
                    Grid.Column="2"
                    Style="{StaticResource PillPrimary}"
                    Text="New post"
                    Command="{Binding NewCommand}"
                    IsVisible="{Binding IsAdminView}"
                    IsEnabled="{Binding IsNotBusy}"
                    VerticalOptions="Center"
                    SemanticProperties.Hint="Write an announcement for this group" />

                <!-- Member: leave this group -->
                <Button
                    Grid.Column="2"
                    Style="{StaticResource IconButton}"
                    Text="{x:Static h:Icons.Logout}"
                    Command="{Binding LeaveGroupCommand}"
                    IsVisible="{Binding IsMemberView}"
                    IsEnabled="{Binding IsNotBusy}"
                    SemanticProperties.Description="Leave group"
                    SemanticProperties.Hint="You will stop seeing this group's announcements" />
            </Grid>

            <VerticalStackLayout Grid.Row="1" Spacing="8" Margin="16,0,16,8">
                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
                </Border>

                <!-- Admin: the planned outage (or its cancellation), next to the regular messages.
                     Amber stripe while planned, green once cancelled. A cancelled one can be deleted. -->
                <Border Style="{StaticResource AccentCard}" IsVisible="{Binding HasOutage}">
                    <Grid ColumnDefinitions="6,*">
                        <BoxView Grid.Column="0" Color="{Binding Outage.AccentColor}" />
                        <VerticalStackLayout Grid.Column="1" Padding="14,12,14,14" Spacing="8">
                            <Border Style="{StaticResource BadgeWarning}" Padding="10,4">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Style="{StaticResource EmojiIcon}" FontSize="13" Text="&#x26A1;" />
                                    <Label Style="{StaticResource BadgeWarningText}" Text="{Binding Outage.Title}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Style="{StaticResource BodyText}" Text="{Binding Outage.Message}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding Outage.WindowText}" />
                            <HorizontalStackLayout Spacing="8">
                                <Button
                                    Style="{StaticResource PillTonal}"
                                    Text="Cancel outage"
                                    Command="{Binding Outage.CancelCommand}"
                                    IsVisible="{Binding Outage.CanCancel}"
                                    SemanticProperties.Hint="Members will see an outage-cancelled message instead" />
                                <Button
                                    Style="{StaticResource PillDanger}"
                                    Text="Delete message"
                                    Command="{Binding Outage.DeleteCommand}"
                                    IsVisible="{Binding Outage.CanDelete}"
                                    SemanticProperties.Hint="Removes the cancelled-outage message so members see the regular message" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Feed -->
            <Grid Grid.Row="2">

                <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                    <CollectionView
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        Margin="16,0">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnnouncementListItem">
                                <!-- Card: coloured status stripe | chips, status, content, actions, footer -->
                                <Border Style="{StaticResource AccentCard}" Opacity="{Binding CardOpacity}">
                                    <Grid ColumnDefinitions="6,*">
                                        <BoxView Grid.Column="0" Color="{Binding Extras.AccentColor}" />

                                        <VerticalStackLayout Grid.Column="1" Padding="14,12,14,12" Spacing="10">

                                            <!-- Chips: New, Edited, Deleted, Another admin -->
                                            <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasBadges}">
                                                <Border Style="{StaticResource BadgeBrand}" IsVisible="{Binding IsNew}">
                                                    <Label Style="{StaticResource BadgeBrandText}" Text="New" />
                                                </Border>
                                                <Border Style="{StaticResource BadgeNeutral}" IsVisible="{Binding IsEdited}">
                                                    <Label Style="{StaticResource BadgeNeutralText}" Text="Edited" />
                                                </Border>
                                                <Border Style="{StaticResource BadgeDanger}" IsVisible="{Binding IsDeleted}">
                                                    <Label Style="{StaticResource BadgeDangerText}" Text="Deleted" />
                                                </Border>
                                                <Border Style="{StaticResource BadgeNeutral}" IsVisible="{Binding IsByOtherAdmin}">
                                                    <Label Style="{StaticResource BadgeNeutralText}" Text="Another admin" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <!-- Status row: state and countdown on one line -->
                                            <HorizontalStackLayout Spacing="8">
                                                <Border Style="{StaticResource BadgeDanger}" IsVisible="{Binding Extras.IsActive}" Padding="10,4">
                                                    <HorizontalStackLayout Spacing="8">
                                                        <controls:BlinkingDot IsVisible="{Binding Extras.IsActive}" VerticalOptions="Center" />
                                                        <Label Style="{StaticResource BadgeDangerText}" Text="Work in progress" />
                                                    </HorizontalStackLayout>
                                                </Border>
                                                <Border Style="{StaticResource BadgeSuccess}" IsVisible="{Binding Extras.IsCompleted}" Padding="10,4">
                                                    <Label Style="{StaticResource BadgeSuccessText}" Text="{Binding Extras.CompletedText}" />
                                                </Border>
                                                <Border Style="{StaticResource BadgeWarning}" IsVisible="{Binding Extras.ShowTimer}" Padding="10,4">
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Style="{StaticResource EmojiIcon}" FontSize="13" Text="&#x23F1;&#xFE0F;" />
                                                        <Label Style="{StaticResource BadgeWarningText}" Text="{Binding Extras.TimeLeftText}" SemanticProperties.Description="Time left" />
                                                    </HorizontalStackLayout>
                                                </Border>
                                                <Border Style="{StaticResource BadgeWarning}" IsVisible="{Binding Extras.ShowTimeUp}" Padding="10,4">
                                                    <Label Style="{StaticResource BadgeWarningText}" Text="Time is up" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <!-- Content -->
                                            <VerticalStackLayout Spacing="4">
                                                <Label Style="{StaticResource AnnouncementTitle}" Text="{Binding Title}" />
                                                <Label Style="{StaticResource BodyText}" Text="{Binding Message}" />
                                            </VerticalStackLayout>
                                            <Image
                                                Source="{Binding Image}"
                                                IsVisible="{Binding HasImage}"
                                                Aspect="AspectFit"
                                                MaximumHeightRequest="240"
                                                HorizontalOptions="Fill"
                                                SemanticProperties.Description="Attached image" />
                                            <Border
                                                Style="{StaticResource RowCard}"
                                                IsVisible="{Binding HasFile}"
                                                SemanticProperties.Description="{Binding FileLabel}"
                                                SemanticProperties.Hint="Opens the file">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenFileCommand}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <Label Grid.Column="0" Style="{StaticResource Icon}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.File}" />
                                                    <Label Grid.Column="1" Style="{StaticResource CardTitle}" Text="{Binding FileName}" VerticalOptions="Center" LineBreakMode="MiddleTruncation" MaxLines="1" />
                                                </Grid>
                                            </Border>

                                            <!-- Notice, expected time, and the one member action -->
                                            <Border Style="{StaticResource NoticeBanner}" IsVisible="{Binding Extras.ShowSubMessage}">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Style="{StaticResource NoticeBannerText}" FontFamily="OpenSansSemibold" Text="{Binding Extras.SubMessageTitle}" />
                                                    <Label Style="{StaticResource NoticeBannerText}" Text="{Binding Extras.SubMessageBody}" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <Label Style="{StaticResource Caption}" Text="{Binding Extras.ResolutionText}" IsVisible="{Binding Extras.HasResolution}" />
                                            <Button
                                                Style="{StaticResource PanicButton}"
                                                Text="{Binding Extras.PanicText}"
                                                Command="{Binding Extras.PressPanicCommand}"
                                                IsEnabled="{Binding Extras.CanPressPanic}"
                                                IsVisible="{Binding Extras.ShowPanicButton}"
                                                SemanticProperties.Hint="Reports that the problem is still not solved. Works once" />
                                            <Label Style="{StaticResource Caption}" Text="{Binding Extras.PanicHintText}" IsVisible="{Binding Extras.ShowPanicHint}" />

                                            <!-- Admin tools, separated by a line: panic count and Mark completed -->
                                            <VerticalStackLayout Spacing="8" IsVisible="{Binding Extras.ShowAdminTools}">
                                                <BoxView Style="{StaticResource Hairline}" />
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Border Grid.Column="0" Style="{StaticResource BadgeDanger}" IsVisible="{Binding Extras.HasPanic}" Padding="12,6">
                                                        <Label Style="{StaticResource BadgeDangerText}" FontSize="15" Text="{Binding Extras.PanicCountText}" />
                                                    </Border>
                                                    <Label Grid.Column="0" Style="{StaticResource Caption}" Text="{Binding Extras.PanicCountText}" IsVisible="{Binding Extras.HasNoPanic}" VerticalOptions="Center" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Style="{StaticResource PillTonal}"
                                                        Text="Mark completed"
                                                        Command="{Binding Extras.CompleteCommand}"
                                                        IsVisible="{Binding Extras.CanMarkCompleted}"
                                                        SemanticProperties.Hint="Marks the work as completed and lets members report problems" />
                                                </Grid>
                                            </VerticalStackLayout>

                                            <!-- Footer: date, and (admin, own posts) the delete icon -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource Caption}"
                                                    Text="{Binding DateText}"
                                                    VerticalOptions="Center" />
                                                <HorizontalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding CanManage}">
                                                    <Button
                                                        Style="{StaticResource IconButtonDanger}"
                                                        Text="{x:Static h:Icons.Delete}"
                                                        Command="{Binding DeleteCommand}"
                                                        SemanticProperties.Description="{Binding DeleteLabel}" />
                                                </HorizontalStackLayout>
                                            </Grid>

                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <Grid HeightRequest="12" />
                        </CollectionView.Footer>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout
                                x:DataType="vm:AnnouncementsViewModel"
                                IsVisible="{Binding HasNoItems}"
                                Spacing="8"
                                Padding="0,40,0,0"
                                HorizontalOptions="Center">
                                <Border Style="{StaticResource EmptyIconTile}">
                                    <Label Style="{StaticResource EmojiIcon}" FontSize="26" AutomationProperties.IsInAccessibleTree="False" Text="&#x1F4E2;" />
                                </Border>
                                <Label Style="{StaticResource CardTitle}" Text="No announcements yet" HorizontalOptions="Center" />
                                <Label
                                    Style="{StaticResource Caption}"
                                    Text="{Binding EmptyHint}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </RefreshView>

                <controls:SkeletonList Kind="Post" IsVisible="{Binding ShowLoading}" VerticalOptions="Start" Margin="16,0" />

            </Grid>

            <Button
                Grid.Row="3"
                Style="{StaticResource PillTonal}"
                Text="Load more"
                Command="{Binding LoadMoreCommand}"
                IsVisible="{Binding HasMore}"
                IsEnabled="{Binding IsNotBusy}"
                HorizontalOptions="Center"
                Margin="0,4,0,16" />

        </Grid>

        <controls:ToastView x:Name="Toast" />

    </Grid>
</ContentPage>
