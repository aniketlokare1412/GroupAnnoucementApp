<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    xmlns:h="clr-namespace:GroupAnnouncementApp.Helpers"
    xmlns:controls="clr-namespace:GroupAnnouncementApp.Controls"
    x:Class="GroupAnnouncementApp.Views.AudiencePickerPage"
    x:DataType="vm:AudiencePickerViewModel"
    Title="Choose groups">

    <!-- Who gets it: search, three tabs, tick-rows. Built for a few hundred groups (the list scrolls, the header stays).
         Ticking a community or super community ticks all of its active groups. Done confirms; the back arrow cancels. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Padding="16,10,16,6" Spacing="8">

            <Border Style="{StaticResource SearchBorder}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0" Style="{StaticResource SearchIcon}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Search}" />
                    <Entry
                        Grid.Column="1"
                        Style="{StaticResource SearchEntry}"
                        Placeholder="Search by name or number"
                        ReturnType="Search"
                        Text="{Binding SearchText}"
                        SemanticProperties.Description="Search" />
                </Grid>
            </Border>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">

                    <Grid SemanticProperties.Description="Groups" SemanticProperties.Hint="Shows single groups">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSegmentCommand}" CommandParameter="0" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource GroupPill}" IsVisible="{Binding IsNotGroupsSegment}">
                            <Label Style="{StaticResource GroupPillText}" Text="Groups" />
                        </Border>
                        <Border Style="{StaticResource GroupPillOnBlue}" IsVisible="{Binding IsGroupsSegment}">
                            <Label Style="{StaticResource GroupPillTextOnBlue}" Text="Groups" />
                        </Border>
                    </Grid>

                    <Grid SemanticProperties.Description="Communities" SemanticProperties.Hint="Shows communities">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSegmentCommand}" CommandParameter="1" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource GroupPill}" IsVisible="{Binding IsNotCommunitiesSegment}">
                            <Label Style="{StaticResource GroupPillText}" Text="Communities" />
                        </Border>
                        <Border Style="{StaticResource GroupPillOnViolet}" IsVisible="{Binding IsCommunitiesSegment}">
                            <Label Style="{StaticResource GroupPillTextOnViolet}" Text="Communities" />
                        </Border>
                    </Grid>

                    <Grid SemanticProperties.Description="Super communities" SemanticProperties.Hint="Shows super communities">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSegmentCommand}" CommandParameter="2" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource GroupPill}" IsVisible="{Binding IsNotSuperSegment}">
                            <Label Style="{StaticResource GroupPillText}" Text="Super communities" />
                        </Border>
                        <Border Style="{StaticResource GroupPillOnPink}" IsVisible="{Binding IsSuperSegment}">
                            <Label Style="{StaticResource GroupPillTextOnPink}" Text="Super communities" />
                        </Border>
                    </Grid>

                </HorizontalStackLayout>
            </ScrollView>

            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                <Label
                    Grid.Column="0"
                    Style="{StaticResource Caption}"
                    Text="{Binding SummaryText}"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />
                <Button Grid.Column="1" Style="{StaticResource LinkButtonBlue}" Text="Select all results" Command="{Binding SelectAllResultsCommand}" IsEnabled="{Binding IsNotBusy}" SemanticProperties.Hint="Ticks every row the list shows" />
                <Button Grid.Column="2" Style="{StaticResource LinkButtonViolet}" Text="{Binding SelectedOnlyText}" Command="{Binding ToggleSelectedOnlyCommand}" IsEnabled="{Binding IsNotBusy}" />
                <Button Grid.Column="3" Style="{StaticResource LinkButtonDanger}" Text="Clear" Command="{Binding ClearCommand}" IsEnabled="{Binding IsNotBusy}" SemanticProperties.Hint="Unticks everything" />
            </Grid>

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
            </Border>

        </VerticalStackLayout>

        <Grid Grid.Row="1">

            <CollectionView
                ItemsSource="{Binding Rows}"
                SelectionMode="None"
                Margin="16,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AudienceRow">
                        <!-- One line per row: name and detail on the left, the tick on the right. A thin line below. -->
                        <VerticalStackLayout
                            Spacing="0"
                            SemanticProperties.Description="{Binding CardLabel}"
                            SemanticProperties.Hint="Double tap to select or unselect">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,8" MinimumHeightRequest="48">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                </Grid.GestureRecognizers>

                                <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                    <Label
                                        Style="{StaticResource CardTitle}"
                                        FontSize="14"
                                        Text="{Binding Name}"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />
                                    <Label
                                        Style="{StaticResource Caption}"
                                        Text="{Binding DetailText}"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />
                                </VerticalStackLayout>

                                <!-- Tick: empty ring, a dash (some of its groups), or a check (all) -->
                                <Border Grid.Column="1" Style="{StaticResource SelectRing}" IsVisible="{Binding IsNone}" AutomationProperties.IsInAccessibleTree="False" />
                                <Border Grid.Column="1" Style="{StaticResource SelectRingOn}" IsVisible="{Binding IsSome}" AutomationProperties.IsInAccessibleTree="False">
                                    <Label Style="{StaticResource SelectCheck}" Text="{x:Static h:Icons.Remove}" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SelectRingOn}" IsVisible="{Binding IsAll}" AutomationProperties.IsInAccessibleTree="False">
                                    <Label Style="{StaticResource SelectCheck}" Text="{x:Static h:Icons.Check}" />
                                </Border>
                            </Grid>
                            <BoxView Style="{StaticResource Hairline}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Grid HeightRequest="12" />
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        x:DataType="vm:AudiencePickerViewModel"
                        IsVisible="{Binding HasNoRows}"
                        Spacing="8"
                        Padding="0,40,0,0"
                        HorizontalOptions="Center">
                        <Border Style="{StaticResource EmptyIconTile}">
                            <Label Style="{StaticResource EmojiIcon}" FontSize="27" AutomationProperties.IsInAccessibleTree="False" Text="&#x1F465;" />
                        </Border>
                        <Label Style="{StaticResource CardTitle}" Text="{Binding EmptyTitle}" HorizontalOptions="Center" />
                        <Label
                            Style="{StaticResource Caption}"
                            Text="{Binding EmptyHint}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <controls:SkeletonList Kind="Row" IsVisible="{Binding ShowLoading}" VerticalOptions="Start" Margin="16,0" />

        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="0">
            <BoxView Style="{StaticResource Hairline}" />
            <Button
                Style="{StaticResource PillPrimary}"
                Text="{Binding DoneText}"
                Command="{Binding DoneCommand}"
                IsEnabled="{Binding IsNotBusy}"
                HorizontalOptions="Fill"
                Margin="20,8,20,16" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
