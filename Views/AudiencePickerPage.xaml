<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    xmlns:h="clr-namespace:GroupAnnouncementApp.Helpers"
    xmlns:controls="clr-namespace:GroupAnnouncementApp.Controls"
    x:Class="GroupAnnouncementApp.Views.AudiencePickerPage"
    x:DataType="vm:AudiencePickerViewModel"
    Title="Who is this for?">

    <!-- Who gets it: two independent tabs, only the tab you finish on counts.
         Groups: search and tick any active group.
         Communities: one super community, then its communities (tick list), and below the groups that will get it (read-only).
         Done confirms; the back arrow cancels. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Padding="16,10,16,6" Spacing="8">

            <HorizontalStackLayout Spacing="8">

                <Grid SemanticProperties.Description="DTCs" SemanticProperties.Hint="Choose single DTCs">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectSegmentCommand}" CommandParameter="0" />
                    </Grid.GestureRecognizers>
                    <Border Style="{StaticResource GroupPill}" IsVisible="{Binding IsNotGroupsSegment}">
                        <Label Style="{StaticResource GroupPillText}" Text="DTCs" />
                    </Border>
                    <Border Style="{StaticResource GroupPillOnBlue}" IsVisible="{Binding IsGroupsSegment}">
                        <Label Style="{StaticResource GroupPillTextOnBlue}" Text="DTCs" />
                    </Border>
                </Grid>

                <Grid SemanticProperties.Description="AB Switches" SemanticProperties.Hint="Choose a Feeder and its AB Switches">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectSegmentCommand}" CommandParameter="1" />
                    </Grid.GestureRecognizers>
                    <Border Style="{StaticResource GroupPill}" IsVisible="{Binding IsNotHierarchySegment}">
                        <Label Style="{StaticResource GroupPillText}" Text="AB Switches" />
                    </Border>
                    <Border Style="{StaticResource GroupPillOnViolet}" IsVisible="{Binding IsHierarchySegment}">
                        <Label Style="{StaticResource GroupPillTextOnViolet}" Text="AB Switches" />
                    </Border>
                </Grid>

            </HorizontalStackLayout>

            <!-- Groups tab: search -->
            <Border Style="{StaticResource SearchBorder}" IsVisible="{Binding IsGroupsSegment}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0" Style="{StaticResource SearchIcon}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Search}" />
                    <Entry
                        Grid.Column="1"
                        Style="{StaticResource SearchEntry}"
                        Placeholder="Search by name or number"
                        ReturnType="Search"
                        Text="{Binding SearchText}"
                        SemanticProperties.Description="Search" />
                </Grid>
            </Border>

            <!-- Communities tab: the two dropdowns -->
            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsHierarchySegment}">

                <Label Style="{StaticResource FieldLabel}" Text="Feeder" />
                <Border Style="{StaticResource FieldBorder}">
                    <Picker
                        Title="Choose a Feeder"
                        ItemsSource="{Binding SuperChoices}"
                        SelectedIndex="{Binding SelectedSuperIndex}"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="Feeder" />
                </Border>

                <Label Style="{StaticResource FieldLabel}" Text="AB Switches" />
                <Border Style="{StaticResource FieldBorder}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="40"
                          SemanticProperties.Description="AB Switches list"
                          SemanticProperties.Hint="Opens or closes the list of AB Switches">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCommunityPanelCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Style="{StaticResource CardTitle}" FontSize="14" VerticalOptions="Center"
                               Text="{Binding CommunitiesButtonText}" LineBreakMode="TailTruncation" MaxLines="1" />
                        <Label Grid.Column="1" Style="{StaticResource Icon}" VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False"
                               Rotation="{Binding PanelRotation}"
                               Text="{x:Static h:Icons.ChevronRight}" />
                    </Grid>
                </Border>

                <!-- The tick list: opens under the field, scrolls when there are many communities -->
                <Border Style="{StaticResource FieldBorder}" IsVisible="{Binding IsCommunityPanelOpen}" Padding="10,2">
                    <ScrollView MaximumHeightRequest="220">
                        <VerticalStackLayout Spacing="0">

                            <Label Style="{StaticResource Caption}" Padding="0,10" IsVisible="{Binding HasNoCommunities}"
                                   Text="This Feeder has no AB Switches yet." />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,8" MinimumHeightRequest="44"
                                  SemanticProperties.Description="Select all AB Switches">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectAllCommunitiesCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Style="{StaticResource CardTitle}" FontSize="14" VerticalOptions="Center" Text="Select all AB Switches" />
                                <Border Grid.Column="1" Style="{StaticResource SelectRing}" IsVisible="{Binding AllCommunitiesOff}" AutomationProperties.IsInAccessibleTree="False" />
                                <Border Grid.Column="1" Style="{StaticResource SelectRingOn}" IsVisible="{Binding AllCommunitiesOn}" AutomationProperties.IsInAccessibleTree="False">
                                    <Label Style="{StaticResource SelectCheck}" Text="{x:Static h:Icons.Check}" />
                                </Border>
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CommunityOptions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CommunityOptionRow">
                                        <VerticalStackLayout Spacing="0"
                                                             SemanticProperties.Description="{Binding CardLabel}"
                                                             SemanticProperties.Hint="Double tap to select or unselect">
                                            <BoxView Style="{StaticResource Hairline}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,8" MinimumHeightRequest="48">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                                </Grid.GestureRecognizers>
                                                <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                                    <Label Style="{StaticResource CardTitle}" FontSize="14" Text="{Binding Name}" LineBreakMode="TailTruncation" MaxLines="1" />
                                                    <Label Style="{StaticResource Caption}" Text="{Binding Detail}" LineBreakMode="TailTruncation" MaxLines="1" />
                                                </VerticalStackLayout>
                                                <Border Grid.Column="1" Style="{StaticResource SelectRing}" IsVisible="{Binding IsOff}" AutomationProperties.IsInAccessibleTree="False" />
                                                <Border Grid.Column="1" Style="{StaticResource SelectRingOn}" IsVisible="{Binding IsOn}" AutomationProperties.IsInAccessibleTree="False">
                                                    <Label Style="{StaticResource SelectCheck}" Text="{x:Static h:Icons.Check}" />
                                                </Border>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </ScrollView>
                </Border>

                <Label Style="{StaticResource FieldLabel}" Text="{Binding HierarchyHeading}" Margin="0,4,0,0" />

            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">
                <Label
                    Grid.Column="0"
                    Style="{StaticResource Caption}"
                    Text="{Binding SummaryText}"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />
                <Button Grid.Column="1" Style="{StaticResource LinkButtonBlue}" Text="Select all results" Command="{Binding SelectAllResultsCommand}" IsVisible="{Binding IsGroupsSegment}" IsEnabled="{Binding IsNotBusy}" SemanticProperties.Hint="Ticks every DTC the list shows" />
                <Button Grid.Column="2" Style="{StaticResource LinkButtonDanger}" Text="Clear" Command="{Binding ClearCommand}" IsEnabled="{Binding IsNotBusy}" SemanticProperties.Hint="Unticks everything on this tab" />
            </Grid>

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
            </Border>

        </VerticalStackLayout>

        <Grid Grid.Row="1">

            <!-- Groups tab: tick rows -->
            <CollectionView
                ItemsSource="{Binding Rows}"
                IsVisible="{Binding IsGroupsSegment}"
                SelectionMode="None"
                Margin="16,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AudienceRow">
                        <VerticalStackLayout
                            Spacing="0"
                            SemanticProperties.Description="{Binding CardLabel}"
                            SemanticProperties.Hint="Double tap to select or unselect">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,8" MinimumHeightRequest="48">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                </Grid.GestureRecognizers>

                                <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                    <Label
                                        Style="{StaticResource CardTitle}"
                                        FontSize="14"
                                        Text="{Binding Name}"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />
                                    <Label
                                        Style="{StaticResource Caption}"
                                        Text="{Binding DetailText}"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1" Style="{StaticResource SelectRing}" IsVisible="{Binding IsNone}" AutomationProperties.IsInAccessibleTree="False" />
                                <Border Grid.Column="1" Style="{StaticResource SelectRingOn}" IsVisible="{Binding IsSome}" AutomationProperties.IsInAccessibleTree="False">
                                    <Label Style="{StaticResource SelectCheck}" Text="{x:Static h:Icons.Remove}" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SelectRingOn}" IsVisible="{Binding IsAll}" AutomationProperties.IsInAccessibleTree="False">
                                    <Label Style="{StaticResource SelectCheck}" Text="{x:Static h:Icons.Check}" />
                                </Border>
                            </Grid>
                            <BoxView Style="{StaticResource Hairline}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Grid HeightRequest="12" />
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        x:DataType="vm:AudiencePickerViewModel"
                        IsVisible="{Binding HasNoRows}"
                        Spacing="8"
                        Padding="0,40,0,0"
                        HorizontalOptions="Center">
                        <Border Style="{StaticResource EmptyIconTile}">
                            <Label Style="{StaticResource EmojiIcon}" FontSize="27" AutomationProperties.IsInAccessibleTree="False" Text="&#x1F465;" />
                        </Border>
                        <Label Style="{StaticResource CardTitle}" Text="{Binding EmptyTitle}" HorizontalOptions="Center" />
                        <Label
                            Style="{StaticResource Caption}"
                            Text="{Binding EmptyHint}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Communities tab: the groups that will get the message (read-only) -->
            <CollectionView
                ItemsSource="{Binding HierarchyGroups}"
                IsVisible="{Binding IsHierarchySegment}"
                SelectionMode="None"
                Margin="16,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HierarchyGroupRow">
                        <VerticalStackLayout Spacing="0">
                            <VerticalStackLayout Padding="0,8" MinimumHeightRequest="48" Spacing="0" VerticalOptions="Center">
                                <Label
                                    Style="{StaticResource CardTitle}"
                                    FontSize="14"
                                    Text="{Binding Name}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />
                                <Label
                                    Style="{StaticResource Caption}"
                                    Text="{Binding Detail}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />
                            </VerticalStackLayout>
                            <BoxView Style="{StaticResource Hairline}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Grid HeightRequest="12" />
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        x:DataType="vm:AudiencePickerViewModel"
                        IsVisible="{Binding HasNoHierarchyGroups}"
                        Spacing="8"
                        Padding="0,24,0,0"
                        HorizontalOptions="Center">
                        <Border Style="{StaticResource EmptyIconTile}">
                            <Label Style="{StaticResource EmojiIcon}" FontSize="27" AutomationProperties.IsInAccessibleTree="False" Text="&#x1F3D8;&#xFE0F;" />
                        </Border>
                        <Label Style="{StaticResource CardTitle}" Text="{Binding HierarchyEmptyTitle}" HorizontalOptions="Center" />
                        <Label
                            Style="{StaticResource Caption}"
                            Text="{Binding HierarchyEmptyHint}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <controls:SkeletonList Kind="Row" IsVisible="{Binding ShowLoading}" VerticalOptions="Start" Margin="16,0" />

        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="0">
            <BoxView Style="{StaticResource Hairline}" />
            <Button
                Style="{StaticResource PillPrimary}"
                Text="{Binding DoneText}"
                Command="{Binding DoneCommand}"
                IsEnabled="{Binding IsNotBusy}"
                HorizontalOptions="Fill"
                Margin="20,8,20,16" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
