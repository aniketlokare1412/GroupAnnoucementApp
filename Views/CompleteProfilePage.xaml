<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    x:Class="GroupAnnouncementApp.Views.CompleteProfilePage"
    x:DataType="vm:CompleteProfileViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="28,48,28,24" Spacing="24">

            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Image Source="app_logo.png" WidthRequest="88" HeightRequest="88" HorizontalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                <Label
                    Style="{StaticResource PageTitle}"
                    Text="Complete your profile"
                    HorizontalOptions="Center" />
                <Label
                    Style="{StaticResource Caption}"
                    Text="We could not find your profile. Add your details to continue."
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />
                <Border Style="{StaticResource BadgeNeutral}" HorizontalOptions="Center">
                    <Label
                        Style="{StaticResource BadgeNeutralText}"
                        Text="{Binding UserEmail, StringFormat='Signed in as {0}'}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource FieldLabel}" Text="Full name" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry
                                Placeholder="Your name"
                                ReturnType="Next"
                                Text="{Binding Name}"
                                IsEnabled="{Binding IsNotBusy}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource FieldLabel}" Text="Phone number" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry
                                Placeholder="e.g. 9876543210"
                                Keyboard="Telephone"
                                ReturnType="Done"
                                ReturnCommand="{Binding SaveCommand}"
                                Text="{Binding Phone}"
                                IsEnabled="{Binding IsNotBusy}" />
                        </Border>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                        <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
                    </Border>

                    <Button
                        Text="Save and continue"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Margin="0,12,0,0" />

                    <Button
                        Text="Log out"
                        Style="{StaticResource LinkButton}"
                        HorizontalOptions="Center"
                        Command="{Binding LogoutCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        HorizontalOptions="Center" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
