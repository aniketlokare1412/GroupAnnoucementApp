<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    x:Class="GroupAnnouncementApp.Views.GroupEditPage"
    x:DataType="vm:GroupEditViewModel"
    Title="{Binding TitleText}">

    <!-- Create / edit a group. Plain fields, one main button pinned to the bottom. Cancel = the back arrow. -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12,16,12" Spacing="18">

                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="Name" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry
                            Placeholder="Group name"
                            ReturnType="Next"
                            Text="{Binding Name}"
                            MaxLength="{Binding MaxNameLength}"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="Group name" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="Description (optional)" />
                    <Border Style="{StaticResource FieldBorder}" Padding="10,6">
                        <Editor
                            Placeholder="What is this group for?"
                            Text="{Binding Description}"
                            MaxLength="{Binding MaxDescriptionLength}"
                            HeightRequest="140"
                            AutoSize="Disabled"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="Group description" />
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Spacing="0">
            <BoxView Style="{StaticResource Hairline}" />
            <VerticalStackLayout Padding="16,8,16,12" Spacing="8">
                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
                </Border>
                <Button
                    Style="{StaticResource PillPrimary}"
                    Text="Save"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <ActivityIndicator
            Grid.Row="0"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="0,48,0,0" />

    </Grid>
</ContentPage>
