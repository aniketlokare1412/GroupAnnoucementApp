<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    x:Class="GroupAnnouncementApp.Views.GroupMembersPage"
    x:DataType="vm:GroupMembersViewModel"
    Title="Group members">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="8">

        <Label Grid.Row="0" Text="{Binding SummaryText}" FontAttributes="Bold" />

        <Label
            Grid.Row="1"
            Text="{Binding ErrorMessage}"
            IsVisible="{Binding HasError}"
            TextColor="Red" />

        <Grid Grid.Row="2">

            <CollectionView
                ItemsSource="{Binding Members}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedMember}"
                IsEnabled="{Binding IsNotBusy}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MemberListItem">
                        <VerticalStackLayout Padding="8,10" Spacing="2">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Email}" />
                            <Label Text="{Binding StatusText}" TextColor="Gray" IsVisible="{Binding HasStatus}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                Text="No members yet. Tap Add members."
                IsVisible="{Binding HasNoMembers}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button
                Grid.Column="0"
                Text="Add members"
                Command="{Binding AddMembersCommand}"
                IsEnabled="{Binding IsNotBusy}" />
            <Button
                Grid.Column="1"
                Text="Refresh"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsNotBusy}" />
        </Grid>

    </Grid>
</ContentPage>
