<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    x:Class="GroupAnnouncementApp.Views.GroupsPage"
    x:DataType="vm:GroupsViewModel"
    Title="Manage groups">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="8">

        <SearchBar
            Grid.Row="0"
            Placeholder="Search by name or description"
            Text="{Binding SearchText}" />

        <Label Grid.Row="1" Text="{Binding SummaryText}" />

        <Label
            Grid.Row="2"
            Text="{Binding ErrorMessage}"
            IsVisible="{Binding HasError}"
            TextColor="Red" />

        <Grid Grid.Row="3">

            <CollectionView
                ItemsSource="{Binding Groups}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedGroup}"
                IsEnabled="{Binding IsNotBusy}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupListItem">
                        <VerticalStackLayout Padding="8,10" Spacing="2">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="Active" TextColor="Green" IsVisible="{Binding IsActive}" />
                                <Label Text="Inactive" TextColor="Red" IsVisible="{Binding IsInactive}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                Text="No groups found."
                IsVisible="{Binding HasNoGroups}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        </Grid>

        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button
                Grid.Column="0"
                Text="Add group"
                Command="{Binding AddGroupCommand}"
                IsEnabled="{Binding IsNotBusy}" />
            <Button
                Grid.Column="1"
                Text="Refresh"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsNotBusy}" />
        </Grid>

    </Grid>
</ContentPage>
