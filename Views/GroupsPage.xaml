<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    xmlns:h="clr-namespace:GroupAnnouncementApp.Helpers"
    xmlns:controls="clr-namespace:GroupAnnouncementApp.Controls"
    x:Class="GroupAnnouncementApp.Views.GroupsPage"
    x:DataType="vm:GroupsViewModel"
    Title="Groups"
    Shell.NavBarIsVisible="False">

    <!-- Admin Groups tab. Same header style as Home (the nav bar is hidden). -->
    <Grid>

        <Grid RowDefinitions="Auto,*">

            <VerticalStackLayout Grid.Row="0" Padding="16,12,16,6" Spacing="8">

                <!-- Title + the page actions. "New group" is the one text button. -->
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                        <Label Style="{StaticResource HeroName}" Text="{Binding HeaderTitle}" />
                        <Label Style="{StaticResource Caption}" Text="{Binding SummaryText}" />
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Text="{x:Static h:Icons.AccountTree}"
                        Command="{Binding OpenStructureCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="Structure"
                        SemanticProperties.Hint="Shows super communities, communities and groups as one tree" />
                    <Button
                        Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Text="{x:Static h:Icons.Campaign}"
                        Command="{Binding NewAnnouncementCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        SemanticProperties.Description="New post"
                        SemanticProperties.Hint="Write an announcement for one or more groups" />
                    <Button
                        Grid.Column="3"
                        Style="{StaticResource PillPrimary}"
                        Text="{Binding NewButtonText}"
                        Command="{Binding AddGroupCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        VerticalOptions="Center" />
                </Grid>

                <!-- Switcher: Groups / Communities / Super communities (not a fourth tab) -->
                <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Start" JustifyContent="Start">
                    <Grid Margin="0,0,8,0" SemanticProperties.Description="Groups" SemanticProperties.Hint="Show groups">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectModeCommand}" CommandParameter="0" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource GroupPill}" IsVisible="{Binding IsNotGroupsMode}">
                            <Label Style="{StaticResource GroupPillText}" Text="Groups" />
                        </Border>
                        <Border Style="{StaticResource GroupPillOn}" IsVisible="{Binding IsGroupsMode}">
                            <Label Style="{StaticResource GroupPillTextOn}" Text="Groups" />
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,8,0" SemanticProperties.Description="Communities" SemanticProperties.Hint="Show communities">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectModeCommand}" CommandParameter="1" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource GroupPill}" IsVisible="{Binding IsNotCommunitiesMode}">
                            <Label Style="{StaticResource GroupPillText}" Text="Communities" />
                        </Border>
                        <Border Style="{StaticResource GroupPillOn}" IsVisible="{Binding IsCommunitiesMode}">
                            <Label Style="{StaticResource GroupPillTextOn}" Text="Communities" />
                        </Border>
                    </Grid>
                    <Grid SemanticProperties.Description="Super communities" SemanticProperties.Hint="Show super communities">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectModeCommand}" CommandParameter="2" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource GroupPill}" IsVisible="{Binding IsNotSuperMode}">
                            <Label Style="{StaticResource GroupPillText}" Text="Super communities" />
                        </Border>
                        <Border Style="{StaticResource GroupPillOn}" IsVisible="{Binding IsSuperMode}">
                            <Label Style="{StaticResource GroupPillTextOn}" Text="Super communities" />
                        </Border>
                    </Grid>
                </FlexLayout>

                <Border Style="{StaticResource SearchBorder}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Style="{StaticResource SearchIcon}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Search}" />
                        <Entry
                            Grid.Column="1"
                            Style="{StaticResource SearchEntry}"
                            Placeholder="{Binding SearchPlaceholder}"
                            ReturnType="Search"
                            Text="{Binding SearchText}"
                            SemanticProperties.Description="Search groups" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
                </Border>

            </VerticalStackLayout>

            <Grid Grid.Row="1">

                <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}" IsVisible="{Binding IsGroupsMode}">
                    <CollectionView
                        ItemsSource="{Binding Groups}"
                        SelectionMode="None"
                        Margin="16,0">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupListItem">
                                <Border Style="{StaticResource RowCard}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                                        <!-- Tap this part: opens the group's announcements -->
                                        <Grid
                                            Grid.Column="0"
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="10"
                                            SemanticProperties.Description="{Binding CardLabel}"
                                            SemanticProperties.Hint="Opens announcements">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                            </Grid.GestureRecognizers>

                                            <Border Grid.Column="0" Style="{StaticResource InitialsTile}" IsVisible="{Binding IsActive}">
                                                <Label Style="{StaticResource InitialsText}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding Initials}" />
                                            </Border>
                                            <Border Grid.Column="0" Style="{StaticResource InitialsTileMuted}" IsVisible="{Binding IsInactive}">
                                                <Label Style="{StaticResource InitialsTextMuted}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding Initials}" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource CardTitle}"
                                                        Text="{Binding Name}"
                                                        LineBreakMode="TailTruncation"
                                                        MaxLines="1"
                                                        VerticalOptions="Center" />
                                                    <Border Grid.Column="1" Style="{StaticResource BadgeNeutral}" IsVisible="{Binding IsInactive}" AutomationProperties.IsInAccessibleTree="False">
                                                        <Label Style="{StaticResource BadgeNeutralText}" Text="Inactive" />
                                                    </Border>
                                                </Grid>
                                                <Label
                                                    Style="{StaticResource Caption}"
                                                    Text="{Binding Description}"
                                                    IsVisible="{Binding HasDescription}"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="1" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- Icon actions: members, edit, activate / deactivate -->
                                        <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Button
                                                Style="{StaticResource IconButton}"
                                                Text="{x:Static h:Icons.Group}"
                                                Command="{Binding MembersCommand}"
                                                SemanticProperties.Description="{Binding MembersLabel}" />
                                            <Button
                                                Style="{StaticResource IconButton}"
                                                Text="{x:Static h:Icons.Edit}"
                                                Command="{Binding EditCommand}"
                                                SemanticProperties.Description="{Binding EditLabel}" />
                                        </HorizontalStackLayout>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <Grid HeightRequest="12" />
                        </CollectionView.Footer>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout
                                x:DataType="vm:GroupsViewModel"
                                IsVisible="{Binding HasNoGroups}"
                                Spacing="8"
                                Padding="0,40,0,0"
                                HorizontalOptions="Center">
                                <Border Style="{StaticResource EmptyIconTile}">
                                    <Label Style="{StaticResource EmptyIcon}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Group}" />
                                </Border>
                                <Label Style="{StaticResource CardTitle}" Text="{Binding EmptyTitle}" HorizontalOptions="Center" />
                                <Label
                                    Style="{StaticResource Caption}"
                                    Text="{Binding EmptyHint}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </RefreshView>

                <!-- Communities / Super communities list (same card style as groups) -->
                <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}" IsVisible="{Binding IsNotGroupsMode}">
                    <CollectionView
                        ItemsSource="{Binding Communities}"
                        SelectionMode="None"
                        Margin="16,0">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommunityListItem">
                                <Border Style="{StaticResource RowCard}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                                        <Grid
                                            Grid.Column="0"
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="10"
                                            SemanticProperties.Description="{Binding Name}"
                                            SemanticProperties.Hint="Opens the editor">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding EditCommand}" />
                                            </Grid.GestureRecognizers>

                                            <Border Grid.Column="0" Style="{StaticResource InitialsTile}">
                                                <Label Style="{StaticResource InitialsText}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding Initials}" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                <Label
                                                    Style="{StaticResource CardTitle}"
                                                    Text="{Binding Name}"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="1" />
                                                <Label
                                                    Style="{StaticResource Caption}"
                                                    Text="{Binding Subtitle}"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="1" />
                                                <Label
                                                    Style="{StaticResource Caption}"
                                                    Text="{Binding Description}"
                                                    IsVisible="{Binding HasDescription}"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="1" />
                                                <!-- Small chips: what is inside / where it belongs -->
                                                <HorizontalStackLayout Spacing="4" Margin="0,2,0,0" IsVisible="{Binding HasChips}" BindableLayout.ItemsSource="{Binding Chips}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border Style="{StaticResource BadgeNeutral}" AutomationProperties.IsInAccessibleTree="False">
                                                                <Label Style="{StaticResource BadgeNeutralText}" Text="{Binding .}" MaximumWidthRequest="110" LineBreakMode="TailTruncation" MaxLines="1" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource IconButton}"
                                            Text="{x:Static h:Icons.Edit}"
                                            Command="{Binding EditCommand}"
                                            VerticalOptions="Center"
                                            SemanticProperties.Description="{Binding EditLabel}" />

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <Grid HeightRequest="12" />
                        </CollectionView.Footer>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout
                                x:DataType="vm:GroupsViewModel"
                                IsVisible="{Binding HasNoGroups}"
                                Spacing="8"
                                Padding="0,40,0,0"
                                HorizontalOptions="Center">
                                <Border Style="{StaticResource EmptyIconTile}">
                                    <Label Style="{StaticResource EmptyIcon}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Group}" />
                                </Border>
                                <Label Style="{StaticResource CardTitle}" Text="{Binding EmptyTitle}" HorizontalOptions="Center" />
                                <Label
                                    Style="{StaticResource Caption}"
                                    Text="{Binding EmptyHint}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </RefreshView>

                <controls:SkeletonList Kind="Row" IsVisible="{Binding ShowLoading}" VerticalOptions="Start" Margin="16,0" />

            </Grid>
        </Grid>

        <controls:ToastView x:Name="Toast" />

    </Grid>
</ContentPage>
