<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    xmlns:h="clr-namespace:GroupAnnouncementApp.Helpers"
    xmlns:controls="clr-namespace:GroupAnnouncementApp.Controls"
    x:Class="GroupAnnouncementApp.Views.HomePage"
    x:DataType="vm:HomeViewModel"
    Title="Home"
    Shell.NavBarIsVisible="False">

    <Grid>

        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="16,14,16,20" Spacing="14">

                    <!-- Header: greeting + avatar (opens Account) -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Style="{StaticResource Greeting}" Text="{Binding Greeting}" />
                            <Label
                                Style="{StaticResource HeroName}"
                                Text="{Binding FirstName}"
                                LineBreakMode="TailTruncation"
                                MaxLines="1" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource AvatarButton}"
                            Text="{Binding Initials}"
                            Command="{Binding OpenAccountCommand}"
                            SemanticProperties.Description="Account"
                            SemanticProperties.Hint="Opens your profile and log out" />
                    </Grid>

                    <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                        <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
                    </Border>

                    <controls:SkeletonList Kind="Row" IsVisible="{Binding ShowLoading}" />

                    <!-- ================= ADMIN ================= -->
                    <VerticalStackLayout Spacing="14" IsVisible="{Binding ShowAdmin}">

                        <!-- Counts -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Style="{StaticResource Card3D}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Grid.Column="0" Style="{StaticResource IconTileViolet}" VerticalOptions="Center">
                                        <Label Style="{StaticResource EmojiIcon}" AutomationProperties.IsInAccessibleTree="False" Text="&#x1F465;" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Label Style="{StaticResource StatNumber}" Text="{Binding GroupsCountText}" />
                                        <Label Style="{StaticResource Caption}" Text="Groups" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card3D}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Grid.Column="0" Style="{StaticResource IconTileGreen}" VerticalOptions="Center">
                                        <Label Style="{StaticResource EmojiIcon}" AutomationProperties.IsInAccessibleTree="False" Text="&#x1F464;" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Label Style="{StaticResource StatNumber}" Text="{Binding UsersCountText}" />
                                        <Label Style="{StaticResource Caption}" Text="Users" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Admin requests: only shown while someone is waiting -->
                        <Border Style="{StaticResource Card3D}" IsVisible="{Binding HasPendingRequests}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" Style="{StaticResource IconTileAmber}" VerticalOptions="Center">
                                    <Label Style="{StaticResource EmojiIcon}" AutomationProperties.IsInAccessibleTree="False" Text="&#x1F64B;" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Style="{StaticResource CardTitle}" Text="Admin requests" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding PendingRequestsText}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="2"
                                    Style="{StaticResource PillTonal}"
                                    Text="Review"
                                    Command="{Binding OpenAdminRequestsCommand}"
                                    SemanticProperties.Hint="Approve or decline requests to become an administrator" />
                            </Grid>
                        </Border>

                        <!-- Quick actions: colour emoji buttons with a caption; New post is the solid one -->
                        <VerticalStackLayout Spacing="8">
                            <Label Style="{StaticResource SectionLabel}" Text="Quick actions" />
                            <HorizontalStackLayout Spacing="18">
                                <VerticalStackLayout Spacing="4" WidthRequest="68">
                                    <Button
                                        Style="{StaticResource EmojiButtonViolet}"
                                        Text="&#x1F465;"
                                        Command="{Binding NewGroupCommand}"
                                        SemanticProperties.Description="New group"
                                        SemanticProperties.Hint="Create a group" />
                                    <Label Style="{StaticResource QuickActionLabel}" Text="New group" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4" WidthRequest="68">
                                    <Button
                                        Style="{StaticResource EmojiButtonBlue}"
                                        Text="&#x1F4E2;"
                                        Command="{Binding NewPostCommand}"
                                        SemanticProperties.Description="New post"
                                        SemanticProperties.Hint="Write an announcement for one or more groups" />
                                    <Label Style="{StaticResource QuickActionLabel}" Text="New post" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4" WidthRequest="68">
                                    <Button
                                        Style="{StaticResource EmojiButtonAmber}"
                                        Text="&#x26A1;"
                                        Command="{Binding NewOutageCommand}"
                                        SemanticProperties.Description="Plan an outage"
                                        SemanticProperties.Hint="Schedule a planned outage message for one or more groups" />
                                    <Label Style="{StaticResource QuickActionLabel}" Text="Outage" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Every group: tap one to see its announcements -->
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Style="{StaticResource SectionLabel}" Text="Groups" />
                            </Grid>

                            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding AdminGroups}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HomeGroupItem">
                                        <Border
                                            Style="{StaticResource RowCard}"
                                            SemanticProperties.Description="{Binding Name}"
                                            SemanticProperties.Hint="Opens announcements">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Grid.Column="0" Style="{StaticResource InitialsTile}" BackgroundColor="{Binding TileBackground}" IsVisible="{Binding IsActive}">
                                                    <Label Style="{StaticResource InitialsText}" TextColor="{Binding TileForeground}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding Initials}" />
                                                </Border>
                                                <Border Grid.Column="0" Style="{StaticResource InitialsTileMuted}" IsVisible="{Binding IsInactive}">
                                                    <Label Style="{StaticResource InitialsTextMuted}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding Initials}" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                    <Label
                                                        Style="{StaticResource CardTitle}"
                                                        Text="{Binding Name}"
                                                        LineBreakMode="TailTruncation"
                                                        MaxLines="1" />
                                                    <Label
                                                        Style="{StaticResource Caption}"
                                                        Text="{Binding Description}"
                                                        IsVisible="{Binding HasDescription}"
                                                        LineBreakMode="TailTruncation"
                                                        MaxLines="1" />
                                                    <Border Style="{StaticResource BadgeNeutral}" IsVisible="{Binding IsInactive}">
                                                        <Label Style="{StaticResource BadgeNeutralText}" Text="Inactive" />
                                                    </Border>
                                                </VerticalStackLayout>
                                                <Label
                                                    Grid.Column="2"
                                                    Style="{StaticResource IconMuted}" AutomationProperties.IsInAccessibleTree="False"
                                                    Text="{x:Static h:Icons.ChevronRight}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label
                                Style="{StaticResource Caption}"
                                Text="No groups yet. Open the Groups tab to create one."
                                IsVisible="{Binding HasNoAdminGroups}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- ================= MEMBER ================= -->
                    <VerticalStackLayout Spacing="14" IsVisible="{Binding ShowMember}">

                        <!-- Join a group by number -->
                        <controls:JoinGroupSection x:Name="JoinSection" />

                        <!-- Announcements: the latest one from each joined group -->
                        <VerticalStackLayout Spacing="10">
                            <Label Style="{StaticResource SectionLabel}" Text="Announcements" />

                            <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding MemberAnnouncements}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MemberAnnouncementItem">
                                        <!-- Card: coloured status stripe | header, status, content, one action -->
                                        <Border Style="{StaticResource AccentCard}" SemanticProperties.Description="{Binding CardLabel}">
                                            <Grid ColumnDefinitions="6,*">
                                                <BoxView Grid.Column="0" Color="{Binding AccentColor}" />

                                                <VerticalStackLayout Grid.Column="1" Padding="14,12,14,14" Spacing="10">

                                                    <!-- 1. Header: group tile, name and number on the left, date on the right -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Style="{StaticResource InitialsTile}" BackgroundColor="{Binding TileBackground}">
                                                            <Label Style="{StaticResource InitialsText}" TextColor="{Binding TileForeground}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding GroupInitials}" />
                                                        </Border>
                                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                            <Label Style="{StaticResource CardTitle}" Text="{Binding GroupName}" LineBreakMode="TailTruncation" MaxLines="1" />
                                                            <Label Style="{StaticResource Caption}" Text="{Binding GroupNumberText}" />
                                                        </VerticalStackLayout>
                                                        <Label Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding DateText}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                                    </Grid>

                                                    <!-- 2. Status row: one line with the state and the countdown (real announcements only) -->
                                                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasExtras}">
                                                        <Border Style="{StaticResource BadgeDanger}" IsVisible="{Binding Extras.IsActive}" Padding="10,4">
                                                            <HorizontalStackLayout Spacing="8">
                                                                <controls:BlinkingDot IsVisible="{Binding Extras.IsActive}" VerticalOptions="Center" />
                                                                <Label Style="{StaticResource BadgeDangerText}" Text="Work in progress" />
                                                            </HorizontalStackLayout>
                                                        </Border>
                                                        <Border Style="{StaticResource BadgeSuccess}" IsVisible="{Binding Extras.IsCompleted}" Padding="10,4">
                                                            <Label Style="{StaticResource BadgeSuccessText}" Text="{Binding Extras.CompletedText}" />
                                                        </Border>
                                                        <Border Style="{StaticResource BadgeWarning}" IsVisible="{Binding Extras.ShowTimer}" Padding="10,4">
                                                            <HorizontalStackLayout Spacing="6">
                                                                <Label Style="{StaticResource EmojiIcon}" FontSize="13" Text="&#x23F1;&#xFE0F;" />
                                                                <Label Style="{StaticResource BadgeWarningText}" Text="{Binding Extras.TimeLeftText}" SemanticProperties.Description="Time left" />
                                                            </HorizontalStackLayout>
                                                        </Border>
                                                        <Border Style="{StaticResource BadgeWarning}" IsVisible="{Binding Extras.ShowTimeUp}" Padding="10,4">
                                                            <Label Style="{StaticResource BadgeWarningText}" Text="Time is up" />
                                                        </Border>
                                                    </HorizontalStackLayout>

                                                    <!-- 3. Content -->
                                                    <VerticalStackLayout Spacing="4">
                                                        <Label Style="{StaticResource AnnouncementTitle}" Text="{Binding Title}" />
                                                        <Label Style="{StaticResource BodyText}" Text="{Binding Message}" />
                                                    </VerticalStackLayout>
                                                    <Image
                                                        Source="{Binding Image}"
                                                        IsVisible="{Binding HasImage}"
                                                        Aspect="AspectFit"
                                                        MaximumHeightRequest="240"
                                                        HorizontalOptions="Fill"
                                                        SemanticProperties.Description="Attached image" />
                                                    <Border
                                                        Style="{StaticResource RowCard}"
                                                        IsVisible="{Binding HasFile}"
                                                        SemanticProperties.Description="{Binding FileLabel}"
                                                        SemanticProperties.Hint="Opens the file">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding OpenFileCommand}" />
                                                        </Border.GestureRecognizers>
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <Label Grid.Column="0" Style="{StaticResource Icon}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.File}" />
                                                            <Label Grid.Column="1" Style="{StaticResource CardTitle}" Text="{Binding FileName}" VerticalOptions="Center" LineBreakMode="MiddleTruncation" MaxLines="1" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- 4. Notice, expected time, and the one action (real announcements only) -->
                                                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasExtras}">
                                                        <Border Style="{StaticResource NoticeBanner}" IsVisible="{Binding Extras.ShowSubMessage}">
                                                            <VerticalStackLayout Spacing="4">
                                                                <Label Style="{StaticResource NoticeBannerText}" FontFamily="OpenSansSemibold" Text="{Binding Extras.SubMessageTitle}" />
                                                                <Label Style="{StaticResource NoticeBannerText}" Text="{Binding Extras.SubMessageBody}" />
                                                            </VerticalStackLayout>
                                                        </Border>
                                                        <Label Style="{StaticResource Caption}" Text="{Binding Extras.ResolutionText}" IsVisible="{Binding Extras.HasResolution}" />
                                                        <Button
                                                            Style="{StaticResource PanicButton}"
                                                            Text="{Binding Extras.PanicText}"
                                                            Command="{Binding Extras.PressPanicCommand}"
                                                            IsEnabled="{Binding Extras.CanPressPanic}"
                                                            IsVisible="{Binding Extras.ShowPanicButton}"
                                                            SemanticProperties.Hint="Reports that the problem is still not solved. Works once" />
                                                        <Label Style="{StaticResource Caption}" Text="{Binding Extras.PanicHintText}" IsVisible="{Binding Extras.ShowPanicHint}" />
                                                    </VerticalStackLayout>

                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label
                                Style="{StaticResource Caption}"
                                Text="No announcements yet from your groups."
                                IsVisible="{Binding HasNoMemberAnnouncements}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:ToastView x:Name="Toast" />

    </Grid>
</ContentPage>
