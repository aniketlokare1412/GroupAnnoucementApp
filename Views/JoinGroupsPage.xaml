<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    x:Class="GroupAnnouncementApp.Views.JoinGroupsPage"
    x:DataType="vm:JoinGroupsViewModel"
    Title="Discover">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="8">

        <SearchBar
            Grid.Row="0"
            Placeholder="Search groups"
            Text="{Binding SearchText}" />

        <Label Grid.Row="1" Text="{Binding SummaryText}" />

        <Label
            Grid.Row="2"
            Text="{Binding ErrorMessage}"
            IsVisible="{Binding HasError}"
            TextColor="Red" />

        <Label
            Grid.Row="3"
            Text="{Binding NoticeMessage}"
            IsVisible="{Binding HasNotice}"
            TextColor="DarkOrange" />

        <Grid Grid.Row="4">

            <CollectionView
                ItemsSource="{Binding Groups}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedGroup}"
                IsEnabled="{Binding IsNotBusy}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:JoinGroupItem">
                        <VerticalStackLayout Padding="8,10" Spacing="2">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
                            <Label Text="Joined" TextColor="Green" IsVisible="{Binding IsMember}" />
                            <Label Text="Tap to join" TextColor="Gray" IsVisible="{Binding IsNotMember}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                Text="No groups found."
                IsVisible="{Binding HasNoGroups}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        </Grid>

        <Button
            Grid.Row="5"
            Text="Refresh"
            Command="{Binding RefreshCommand}"
            IsEnabled="{Binding IsNotBusy}" />

    </Grid>
</ContentPage>
