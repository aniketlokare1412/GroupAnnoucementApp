<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    xmlns:h="clr-namespace:GroupAnnouncementApp.Helpers"
    xmlns:controls="clr-namespace:GroupAnnouncementApp.Controls"
    x:Class="GroupAnnouncementApp.Views.JoinGroupsPage"
    x:DataType="vm:JoinGroupsViewModel"
    Title="Discover"
    Shell.NavBarIsVisible="False">

    <!-- Member Discover tab. Same header style as Home (the nav bar is hidden). -->
    <Grid>

        <Grid RowDefinitions="Auto,*">

            <!-- Header: title, search, summary, banners -->
            <VerticalStackLayout Grid.Row="0" Padding="16,12,16,6" Spacing="8">

                <VerticalStackLayout Spacing="0">
                    <Label Style="{StaticResource HeroName}" Text="Discover" />
                    <Label Style="{StaticResource Greeting}" Text="Find groups and join the ones you care about" />
                </VerticalStackLayout>

                <Border Style="{StaticResource FieldBorder}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Style="{StaticResource IconMuted}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Search}" />
                        <Entry
                            Grid.Column="1"
                            Placeholder="Search groups"
                            ReturnType="Search"
                            Text="{Binding SearchText}"
                            SemanticProperties.Description="Search groups" />
                    </Grid>
                </Border>

                <Label Style="{StaticResource SectionLabel}" Text="{Binding SummaryText}" />

                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
                </Border>

                <Border Style="{StaticResource NoticeBanner}" IsVisible="{Binding HasNotice}">
                    <Label Style="{StaticResource NoticeBannerText}" Text="{Binding NoticeMessage}" />
                </Border>

            </VerticalStackLayout>

            <!-- List -->
            <Grid Grid.Row="1">

                <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                    <CollectionView
                        ItemsSource="{Binding Groups}"
                        SelectionMode="None"
                        Margin="16,0">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:JoinGroupItem">
                                <Border
                                    Style="{StaticResource RowCard}"
                                    SemanticProperties.Description="{Binding CardLabel}"
                                    SemanticProperties.Hint="{Binding CardHint}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding PrimaryCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                                        <!-- Joined groups get the teal tint; others stay neutral -->
                                        <Border Grid.Column="0" Style="{StaticResource InitialsTile}" IsVisible="{Binding IsMember}">
                                            <Label Style="{StaticResource InitialsText}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding Initials}" />
                                        </Border>
                                        <Border Grid.Column="0" Style="{StaticResource InitialsTileMuted}" IsVisible="{Binding IsNotMember}">
                                            <Label Style="{StaticResource InitialsTextMuted}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding Initials}" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label
                                                Style="{StaticResource CardTitle}"
                                                Text="{Binding Name}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                            <Label
                                                Style="{StaticResource Caption}"
                                                Text="{Binding Description}"
                                                IsVisible="{Binding HasDescription}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                        </VerticalStackLayout>

                                        <Button
                                            Grid.Column="2"
                                            Style="{StaticResource IconButton}"
                                            Text="{x:Static h:Icons.Add}"
                                            Command="{Binding JoinCommand}"
                                            IsVisible="{Binding IsNotMember}"
                                            SemanticProperties.Description="{Binding JoinLabel}" />
                                        <Border
                                            Grid.Column="2"
                                            Style="{StaticResource BadgeSuccess}"
                                            IsVisible="{Binding IsMember}"
                                            VerticalOptions="Center"
                                            AutomationProperties.IsInAccessibleTree="False">
                                            <HorizontalStackLayout Spacing="3">
                                                <Label Style="{StaticResource ChipIcon}" Text="{x:Static h:Icons.Check}" />
                                                <Label Style="{StaticResource BadgeSuccessText}" Text="Joined" />
                                            </HorizontalStackLayout>
                                        </Border>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <BoxView HeightRequest="12" Color="Transparent" />
                        </CollectionView.Footer>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout
                                x:DataType="vm:JoinGroupsViewModel"
                                IsVisible="{Binding HasNoGroups}"
                                Spacing="8"
                                Padding="0,40,0,0"
                                HorizontalOptions="Center">
                                <Border Style="{StaticResource EmptyIconTile}">
                                    <Label Style="{StaticResource EmptyIcon}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Search}" />
                                </Border>
                                <Label Style="{StaticResource CardTitle}" Text="{Binding EmptyTitle}" HorizontalOptions="Center" />
                                <Label
                                    Style="{StaticResource Caption}"
                                    Text="{Binding EmptyHint}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </RefreshView>

                <ActivityIndicator
                    IsRunning="{Binding ShowLoading}"
                    IsVisible="{Binding ShowLoading}"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,48,0,0" />

            </Grid>
        </Grid>

        <controls:ToastView x:Name="Toast" />

    </Grid>
</ContentPage>
