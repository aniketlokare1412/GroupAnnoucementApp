<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    xmlns:h="clr-namespace:GroupAnnouncementApp.Helpers"
    xmlns:controls="clr-namespace:GroupAnnouncementApp.Controls"
    x:Class="GroupAnnouncementApp.Views.OutageEditPage"
    x:DataType="vm:OutageEditViewModel"
    Title="Plan a Shut Down">

    <!-- Admin: date, from and to time, when members start seeing the message, and the groups. -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12,16,12" Spacing="18">

                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="Shut Down date" />
                    <Border Style="{StaticResource FieldBorder}">
                        <DatePicker Date="{Binding OutageDate}" Format="dd/MM/yyyy" IsEnabled="{Binding IsNotBusy}" SemanticProperties.Description="Shut Down date" />
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Style="{StaticResource FieldLabel}" Text="From" />
                        <Border Style="{StaticResource FieldBorder}">
                            <TimePicker Time="{Binding FromTime}" Format="HH:mm" IsEnabled="{Binding IsNotBusy}" SemanticProperties.Description="Shut Down starts at" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Style="{StaticResource FieldLabel}" Text="To" />
                        <Border Style="{StaticResource FieldBorder}">
                            <TimePicker Time="{Binding ToTime}" Format="HH:mm" IsEnabled="{Binding IsNotBusy}" SemanticProperties.Description="Shut Down ends at" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="Members see the message" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource BodyText}" Text="Publish now" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding PublishNow}" IsEnabled="{Binding IsNotBusy}" SemanticProperties.Description="Publish now" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding ShowPublishLater}">
                        <Border Grid.Column="0" Style="{StaticResource FieldBorder}">
                            <DatePicker Date="{Binding PublishDate}" Format="dd/MM/yyyy" IsEnabled="{Binding IsNotBusy}" SemanticProperties.Description="Publish date" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                            <TimePicker Time="{Binding PublishTime}" Format="HH:mm" IsEnabled="{Binding IsNotBusy}" SemanticProperties.Description="Publish time" />
                        </Border>
                    </Grid>
                    <Label Style="{StaticResource Caption}" Text="Members see it until the Shut Down is over, then the regular message returns." />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource FieldLabel}" Text="Send to" />

                    <!-- Who gets it. The card shows the choice; the pills open the picker on that tab.
                         Going back from the picker keeps the old choice. -->
                    <Border
                        Style="{StaticResource RowCard}"
                        SemanticProperties.Description="{Binding SelectedCountText}"
                        SemanticProperties.Hint="Opens the list to change who gets this">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditAudienceCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" Style="{StaticResource IconTileCyan}" VerticalOptions="Center">
                                <Label Style="{StaticResource IconOnCyan}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Group}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Style="{StaticResource CardTitle}" Text="{Binding SelectedCountText}" />
                                <Label Style="{StaticResource Caption}" Text="{Binding AudienceCaption}" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource IconMuted}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.ChevronRight}" />
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">

                    <Grid SemanticProperties.Description="DTCs" SemanticProperties.Hint="Choose single DTCs">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChooseAudienceCommand}" CommandParameter="0" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource GroupPill}" IsVisible="{Binding IsGroupsOff}">
                            <Label Style="{StaticResource GroupPillText}" Text="DTCs" />
                        </Border>
                        <Border Style="{StaticResource GroupPillOnBlue}" IsVisible="{Binding IsGroupsOn}">
                            <Label Style="{StaticResource GroupPillTextOnBlue}" Text="DTCs" />
                        </Border>
                    </Grid>

                    <Grid SemanticProperties.Description="AB Switches" SemanticProperties.Hint="Choose a Feeder and its AB Switches">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChooseAudienceCommand}" CommandParameter="1" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource GroupPill}" IsVisible="{Binding IsCommunitiesOff}">
                            <Label Style="{StaticResource GroupPillText}" Text="AB Switches" />
                        </Border>
                        <Border Style="{StaticResource GroupPillOnViolet}" IsVisible="{Binding IsCommunitiesOn}">
                            <Label Style="{StaticResource GroupPillTextOnViolet}" Text="AB Switches" />
                        </Border>
                    </Grid>

                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Spacing="0">
            <BoxView Style="{StaticResource Hairline}" />
            <VerticalStackLayout Padding="16,8,16,12" Spacing="8">
                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
                </Border>
                <Button
                    Style="{StaticResource PillCoral}"
                    Text="Schedule Shut Down"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
