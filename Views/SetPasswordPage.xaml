<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    x:Class="GroupAnnouncementApp.Views.SetPasswordPage"
    x:DataType="vm:SetPasswordViewModel"
    Shell.NavBarIsVisible="False">

    <!-- Shown once, right after a person is made an admin. -->
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="28,32,28,32" Spacing="0" VerticalOptions="Center">

            <VerticalStackLayout Spacing="6" Margin="0,0,0,32">
                <Label
                    Style="{StaticResource PageTitle}"
                    Text="Choose your password"
                    HorizontalOptions="Center"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Style="{StaticResource Caption}"
                    Text="You are now an admin. Admins log in with their phone number and this password."
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="New password" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry
                            Placeholder="At least 6 characters"
                            IsPassword="True"
                            ReturnType="Next"
                            Text="{Binding NewPassword}"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="New password" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="Confirm password" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry
                            Placeholder="Repeat your password"
                            IsPassword="True"
                            ReturnType="Done"
                            ReturnCommand="{Binding SaveCommand}"
                            Text="{Binding ConfirmPassword}"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="Confirm password" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}" Margin="0,18,0,0">
                <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
            </Border>

            <Button
                Text="Save password"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding IsNotBusy}"
                Margin="0,32,0,0" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                Margin="0,16,0,0" />

            <Button
                Style="{StaticResource LinkButton}"
                Text="Log out"
                Command="{Binding LogoutCommand}"
                IsEnabled="{Binding IsNotBusy}"
                HorizontalOptions="Center"
                Margin="0,20,0,0"
                MinimumHeightRequest="44" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
