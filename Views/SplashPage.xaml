<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    x:Class="GroupAnnouncementApp.Views.SplashPage"
    x:DataType="vm:SplashViewModel"
    Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="30" Spacing="16" VerticalOptions="Center">

        <Label Text="Group Announcements" FontSize="24" HorizontalOptions="Center" />

        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}" />

        <Label
            Text="{Binding ErrorMessage}"
            IsVisible="{Binding HasError}"
            TextColor="Red"
            HorizontalTextAlignment="Center" />

        <Button
            Text="Try again"
            Command="{Binding RetryCommand}"
            IsVisible="{Binding ShowActions}" />

        <Button
            Text="Log out"
            Command="{Binding LogoutCommand}"
            IsVisible="{Binding ShowActions}" />

    </VerticalStackLayout>
</ContentPage>
