<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    xmlns:h="clr-namespace:GroupAnnouncementApp.Helpers"
    xmlns:controls="clr-namespace:GroupAnnouncementApp.Controls"
    x:Class="GroupAnnouncementApp.Views.StructurePage"
    x:DataType="vm:StructureViewModel"
    Title="Structure">

    <!-- Admin: the whole hierarchy in one read-only tree.
         Super community > community > group. Tap a row to edit it; tap the arrow to open or close it. -->
    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="16,10,16,6" Spacing="8">

            <Border Style="{StaticResource SearchBorder}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0" Style="{StaticResource SearchIcon}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Search}" />
                    <Entry
                        Grid.Column="1"
                        Style="{StaticResource SearchEntry}"
                        Placeholder="Search by name or number"
                        ReturnType="Search"
                        Text="{Binding SearchText}"
                        SemanticProperties.Description="Search the structure" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                <Label
                    Grid.Column="0"
                    Style="{StaticResource Caption}"
                    Text="{Binding SummaryText}"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />
                <Button
                    Grid.Column="1"
                    Style="{StaticResource LinkButton}"
                    Text="Expand all"
                    Command="{Binding ExpandAllCommand}" />
                <Button
                    Grid.Column="2"
                    Style="{StaticResource LinkButton}"
                    Text="Collapse all"
                    Command="{Binding CollapseAllCommand}" />
            </Grid>

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
            </Border>

        </VerticalStackLayout>

        <Grid Grid.Row="1">

            <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                <CollectionView
                    ItemsSource="{Binding Rows}"
                    SelectionMode="None"
                    Margin="16,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:StructureNode">
                            <!-- Indented by depth. The arrow only exists on rows that have something inside. -->
                            <Border Style="{StaticResource RowCard}" Margin="{Binding RowMargin}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">

                                    <!-- Tap the name part: edit (or open / close a section header) -->
                                    <Grid
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10"
                                        SemanticProperties.Description="{Binding RowLabel}"
                                        SemanticProperties.Hint="Opens the editor">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                        </Grid.GestureRecognizers>

                                        <Border Grid.Column="0" Style="{StaticResource InitialsTile}" IsVisible="{Binding IsNotSection}">
                                            <Label Style="{StaticResource InitialsText}" AutomationProperties.IsInAccessibleTree="False" Text="{Binding Initials}" />
                                        </Border>
                                        <Border Grid.Column="0" Style="{StaticResource InitialsTileMuted}" IsVisible="{Binding IsSection}">
                                            <Label Style="{StaticResource InitialsTextMuted}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Group}" FontFamily="MaterialIconsRound" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label
                                                Style="{StaticResource CardTitle}"
                                                Text="{Binding Name}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                            <Label
                                                Style="{StaticResource Caption}"
                                                Text="{Binding Caption}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Button
                                        Grid.Column="2"
                                        Style="{StaticResource IconButtonPlain}"
                                        Text="{x:Static h:Icons.ChevronRight}"
                                        Rotation="{Binding ChevronRotation}"
                                        Command="{Binding ToggleCommand}"
                                        IsVisible="{Binding HasChildren}"
                                        VerticalOptions="Center"
                                        SemanticProperties.Description="{Binding ToggleLabel}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <Grid HeightRequest="12" />
                    </CollectionView.Footer>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            x:DataType="vm:StructureViewModel"
                            IsVisible="{Binding HasNoRows}"
                            Spacing="8"
                            Padding="0,40,0,0"
                            HorizontalOptions="Center">
                            <Border Style="{StaticResource EmptyIconTile}">
                                <Label Style="{StaticResource EmptyIcon}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.AccountTree}" />
                            </Border>
                            <Label Style="{StaticResource CardTitle}" Text="{Binding EmptyTitle}" HorizontalOptions="Center" />
                            <Label
                                Style="{StaticResource Caption}"
                                Text="{Binding EmptyHint}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <controls:SkeletonList Kind="Row" IsVisible="{Binding ShowLoading}" VerticalOptions="Start" Margin="16,0" />

        </Grid>
    </Grid>
</ContentPage>
