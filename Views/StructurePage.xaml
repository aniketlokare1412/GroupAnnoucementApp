<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    xmlns:h="clr-namespace:GroupAnnouncementApp.Helpers"
    xmlns:controls="clr-namespace:GroupAnnouncementApp.Controls"
    x:Class="GroupAnnouncementApp.Views.StructurePage"
    x:DataType="vm:StructureViewModel"
    Title="Structure">

    <!-- Admin: the whole hierarchy in one read-only tree.
         Super community > community > group. Tap a row to edit it; tap the arrow to open or close it. -->
    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="16,10,16,6" Spacing="8">

            <Border Style="{StaticResource SearchBorder}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0" Style="{StaticResource SearchIcon}" AutomationProperties.IsInAccessibleTree="False" Text="{x:Static h:Icons.Search}" />
                    <Entry
                        Grid.Column="1"
                        Style="{StaticResource SearchEntry}"
                        Placeholder="Search by name or number"
                        ReturnType="Search"
                        Text="{Binding SearchText}"
                        SemanticProperties.Description="Search the structure" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                <Label
                    Grid.Column="0"
                    Style="{StaticResource Caption}"
                    Text="{Binding SummaryText}"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />
                <Button
                    Grid.Column="1"
                    Style="{StaticResource LinkButtonViolet}"
                    Text="Expand all"
                    Command="{Binding ExpandAllCommand}" />
                <Button
                    Grid.Column="2"
                    Style="{StaticResource LinkButtonViolet}"
                    Text="Collapse all"
                    Command="{Binding CollapseAllCommand}" />
            </Grid>

            <!-- Colour legend -->
            <HorizontalStackLayout Spacing="12">
                <HorizontalStackLayout Spacing="4">
                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center" Color="{AppThemeBinding Light={StaticResource PinkLight}, Dark={StaticResource PinkDark}}" />
                    <Label Style="{StaticResource Caption}" FontSize="11" Text="Super community" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4">
                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center" Color="{AppThemeBinding Light={StaticResource IndigoLight}, Dark={StaticResource IndigoDark}}" />
                    <Label Style="{StaticResource Caption}" FontSize="11" Text="Community" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4">
                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center" Color="{AppThemeBinding Light={StaticResource VioletLight}, Dark={StaticResource VioletDark}}" />
                    <Label Style="{StaticResource Caption}" FontSize="11" Text="Group" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4">
                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center" Color="{AppThemeBinding Light={StaticResource AmberLight}, Dark={StaticResource AmberDark}}" />
                    <Label Style="{StaticResource Caption}" FontSize="11" Text="No community" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
            </Border>

        </VerticalStackLayout>

        <Grid Grid.Row="1">

            <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                <CollectionView
                    ItemsSource="{Binding Rows}"
                    SelectionMode="None"
                    Margin="16,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="2" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:StructureNode">
                            <!-- One compact line per node: colour stripe | arrow | name | count. No card, no pill.
                                 Indented by depth. The arrow only exists on rows that have something inside. -->
                            <Grid
                                ColumnDefinitions="4,Auto,*,Auto"
                                ColumnSpacing="6"
                                Margin="{Binding RowMargin}"
                                MinimumHeightRequest="36">

                                <BoxView Grid.Column="0" WidthRequest="4" CornerRadius="2" Margin="0,3" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding ColorName}" Value="super">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PinkLight}, Dark={StaticResource PinkDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding ColorName}" Value="community">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource IndigoLight}, Dark={StaticResource IndigoDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding ColorName}" Value="group">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource VioletLight}, Dark={StaticResource VioletDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding ColorName}" Value="ungrouped">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AmberLight}, Dark={StaticResource AmberDark}}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>

                                <!-- Arrow (or an empty space of the same width so names line up) -->
                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource IconButtonPlain}"
                                    Text="{x:Static h:Icons.ChevronRight}"
                                    Rotation="{Binding ChevronRotation}"
                                    Command="{Binding ToggleCommand}"
                                    IsVisible="{Binding HasChildren}"
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    Padding="0"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="{Binding ToggleLabel}" />
                                <BoxView Grid.Column="1" WidthRequest="30" HeightRequest="30" Color="Transparent" IsVisible="{Binding HasNoChildren}" />

                                <!-- Tap the name: edit it (a section header opens or closes) -->
                                <Grid
                                    Grid.Column="2"
                                    Grid.ColumnSpan="2"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="8"
                                    SemanticProperties.Description="{Binding RowLabel}"
                                    SemanticProperties.Hint="Opens the editor">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                    </Grid.GestureRecognizers>
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource CardTitle}"
                                        FontSize="14"
                                        Text="{Binding Name}"
                                        VerticalOptions="Center"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource Caption}"
                                        Text="{Binding Caption}"
                                        VerticalOptions="Center"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <Grid HeightRequest="12" />
                    </CollectionView.Footer>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            x:DataType="vm:StructureViewModel"
                            IsVisible="{Binding HasNoRows}"
                            Spacing="8"
                            Padding="0,40,0,0"
                            HorizontalOptions="Center">
                            <Border Style="{StaticResource EmptyIconTile}">
                                <Label Style="{StaticResource EmojiIcon}" FontSize="27" AutomationProperties.IsInAccessibleTree="False" Text="&#x1F3DB;&#xFE0F;" />
                            </Border>
                            <Label Style="{StaticResource CardTitle}" Text="{Binding EmptyTitle}" HorizontalOptions="Center" />
                            <Label
                                Style="{StaticResource Caption}"
                                Text="{Binding EmptyHint}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <controls:SkeletonList Kind="Row" IsVisible="{Binding ShowLoading}" VerticalOptions="Start" Margin="16,0" />

        </Grid>
    </Grid>
</ContentPage>
