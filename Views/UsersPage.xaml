<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    x:Class="GroupAnnouncementApp.Views.UsersPage"
    x:DataType="vm:UsersViewModel"
    Title="Manage users">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="8">

        <SearchBar
            Grid.Row="0"
            Placeholder="Search by name, email or phone"
            Text="{Binding SearchText}" />

        <Label Grid.Row="1" Text="{Binding SummaryText}" />

        <Label
            Grid.Row="2"
            Text="{Binding ErrorMessage}"
            IsVisible="{Binding HasError}"
            TextColor="Red" />

        <Grid Grid.Row="3">

            <CollectionView
                ItemsSource="{Binding Users}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedUser}"
                IsEnabled="{Binding IsNotBusy}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:UserListItem">
                        <VerticalStackLayout Padding="8,10" Spacing="2">
                            <Label Text="{Binding NameText}" FontAttributes="Bold" />
                            <Label Text="{Binding Email}" />
                            <Label Text="{Binding Phone}" />
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{Binding RoleText}" />
                                <Label Text="Active" TextColor="Green" IsVisible="{Binding IsActive}" />
                                <Label Text="Deactivated" TextColor="Red" IsVisible="{Binding IsDeactivated}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                Text="No users found."
                IsVisible="{Binding HasNoUsers}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        </Grid>

        <Button
            Grid.Row="4"
            Text="Refresh"
            Command="{Binding RefreshCommand}"
            IsEnabled="{Binding IsNotBusy}" />

    </Grid>
</ContentPage>
