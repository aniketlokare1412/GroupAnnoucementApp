<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    x:Class="GroupAnnouncementApp.Views.WelcomePage"
    x:DataType="vm:WelcomeViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="20">

            <!-- Brand -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border Style="{StaticResource BrandMark}">
                    <Label Style="{StaticResource BrandMarkText}" Text="GA" />
                </Border>
                <Label
                    Style="{StaticResource PageTitle}"
                    Text="Group Announcements"
                    HorizontalOptions="Center" />
                <Label
                    Style="{StaticResource Caption}"
                    Text="{Binding SubheadingText}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Mode switch: Sign in | Create account -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button
                    Grid.Column="0"
                    Text="Sign in"
                    Style="{StaticResource PillPrimary}"
                    Command="{Binding ShowSignInCommand}"
                    IsVisible="{Binding IsSignInMode}"
                    IsEnabled="{Binding IsNotBusy}" />
                <Button
                    Grid.Column="0"
                    Text="Sign in"
                    Style="{StaticResource PillTonal}"
                    Command="{Binding ShowSignInCommand}"
                    IsVisible="{Binding IsRegisterMode}"
                    IsEnabled="{Binding IsNotBusy}" />
                <Button
                    Grid.Column="1"
                    Text="Create account"
                    Style="{StaticResource PillTonal}"
                    Command="{Binding ShowRegisterCommand}"
                    IsVisible="{Binding IsSignInMode}"
                    IsEnabled="{Binding IsNotBusy}" />
                <Button
                    Grid.Column="1"
                    Text="Create account"
                    Style="{StaticResource PillPrimary}"
                    Command="{Binding ShowRegisterCommand}"
                    IsVisible="{Binding IsRegisterMode}"
                    IsEnabled="{Binding IsNotBusy}" />
            </Grid>

            <!-- Form -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <!-- Create account only -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsRegisterMode}">
                        <Label Style="{StaticResource Caption}" Text="Full name" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry
                                Placeholder="Your name"
                                ReturnType="Next"
                                Text="{Binding Name}"
                                IsEnabled="{Binding IsNotBusy}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsRegisterMode}">
                        <Label Style="{StaticResource Caption}" Text="Phone number" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry
                                Placeholder="e.g. 9876543210"
                                Keyboard="Telephone"
                                ReturnType="Next"
                                Text="{Binding Phone}"
                                IsEnabled="{Binding IsNotBusy}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Both modes -->
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource Caption}" Text="Email" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry
                                Placeholder="name@example.com"
                                Keyboard="Email"
                                ReturnType="Next"
                                Text="{Binding Email}"
                                IsEnabled="{Binding IsNotBusy}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password: Sign in (Enter submits) -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsSignInMode}">
                        <Label Style="{StaticResource Caption}" Text="Password" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry
                                Placeholder="Your password"
                                IsPassword="True"
                                ReturnType="Done"
                                ReturnCommand="{Binding SubmitCommand}"
                                Text="{Binding Password}"
                                IsEnabled="{Binding IsNotBusy}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password: Create account -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsRegisterMode}">
                        <Label Style="{StaticResource Caption}" Text="Password" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry
                                Placeholder="At least 6 characters"
                                IsPassword="True"
                                ReturnType="Next"
                                Text="{Binding Password}"
                                IsEnabled="{Binding IsNotBusy}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsRegisterMode}">
                        <Label Style="{StaticResource Caption}" Text="Confirm password" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry
                                Placeholder="Repeat your password"
                                IsPassword="True"
                                ReturnType="Done"
                                ReturnCommand="{Binding SubmitCommand}"
                                Text="{Binding ConfirmPassword}"
                                IsEnabled="{Binding IsNotBusy}" />
                        </Border>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                        <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
                    </Border>

                    <Button
                        Text="{Binding SubmitText}"
                        Command="{Binding SubmitCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
