<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    x:Class="GroupAnnouncementApp.Views.WelcomePage"
    x:DataType="vm:WelcomeViewModel"
    Shell.NavBarIsVisible="False">

    <!-- One login page. Members: phone number only. Admins: tap the link to also enter a password. -->
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="28,32,28,32" Spacing="0" VerticalOptions="Center">

            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,0,0,36">
                <Image
                    Source="app_logo.png"
                    WidthRequest="88"
                    HeightRequest="88"
                    HorizontalOptions="Center"
                    Margin="0,0,0,10"
                    AutomationProperties.IsInAccessibleTree="False" />
                <Label
                    Style="{StaticResource PageTitle}"
                    Text="Group Announcements"
                    HorizontalOptions="Center"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Style="{StaticResource Caption}"
                    Text="{Binding SubheadingText}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="18">

                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="Phone number" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry
                            Placeholder="e.g. 9876543210"
                            Keyboard="Telephone"
                            ReturnType="Done"
                            ReturnCommand="{Binding SubmitCommand}"
                            Text="{Binding Phone}"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="Phone number" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsAdminMode}">
                    <Label Style="{StaticResource FieldLabel}" Text="Password" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry
                            Placeholder="Your password"
                            IsPassword="True"
                            ReturnType="Done"
                            ReturnCommand="{Binding SubmitCommand}"
                            Text="{Binding Password}"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="Password" />
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}" Margin="0,18,0,0">
                <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
            </Border>

            <Button
                Text="{Binding SubmitText}"
                Command="{Binding SubmitCommand}"
                IsEnabled="{Binding IsNotBusy}"
                Margin="0,32,0,0" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                Margin="0,16,0,0" />

            <Button
                Style="{StaticResource LinkButton}"
                Text="Admin? Log in with password"
                Command="{Binding ShowAdminLoginCommand}"
                IsVisible="{Binding IsMemberMode}"
                IsEnabled="{Binding IsNotBusy}"
                HorizontalOptions="Center"
                Margin="0,20,0,0"
                MinimumHeightRequest="44" />

            <Button
                Style="{StaticResource LinkButton}"
                Text="Not an admin? Continue with phone only"
                Command="{Binding ShowMemberLoginCommand}"
                IsVisible="{Binding IsAdminMode}"
                IsEnabled="{Binding IsNotBusy}"
                HorizontalOptions="Center"
                Margin="0,20,0,0"
                MinimumHeightRequest="44" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
