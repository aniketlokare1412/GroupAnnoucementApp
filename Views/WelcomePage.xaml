<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GroupAnnouncementApp.ViewModels"
    x:Class="GroupAnnouncementApp.Views.WelcomePage"
    x:DataType="vm:WelcomeViewModel"
    Shell.NavBarIsVisible="False">

    <!-- One page for "Log in" and "Create account". No card and no outlines: logo, plain fields, one main button,
         and a quiet text link to switch. With few fields the content sits in the middle of the screen;
         with more (Create account) it scrolls. -->
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="28,32,28,32" Spacing="0" VerticalOptions="Center">

            <!-- Brand -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,0,0,36">
                <Image
                    Source="app_logo.png"
                    WidthRequest="88"
                    HeightRequest="88"
                    HorizontalOptions="Center"
                    Margin="0,0,0,10"
                    AutomationProperties.IsInAccessibleTree="False" />
                <Label
                    Style="{StaticResource PageTitle}"
                    Text="Group Announcements"
                    HorizontalOptions="Center"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Style="{StaticResource Caption}"
                    Text="{Binding SubheadingText}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Fields -->
            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsRegisterMode}">
                    <Label Style="{StaticResource FieldLabel}" Text="Full name" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry
                            Placeholder="Your name"
                            ReturnType="Next"
                            Text="{Binding Name}"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="Full name" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsRegisterMode}">
                    <Label Style="{StaticResource FieldLabel}" Text="Phone number" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry
                            Placeholder="e.g. 9876543210"
                            Keyboard="Telephone"
                            ReturnType="Next"
                            Text="{Binding Phone}"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="Phone number" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="Email" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry
                            Placeholder="name@example.com"
                            Keyboard="Email"
                            ReturnType="Next"
                            Text="{Binding Email}"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="Email" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsSignInMode}">
                    <Label Style="{StaticResource FieldLabel}" Text="Password" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry
                            Placeholder="Your password"
                            IsPassword="True"
                            ReturnType="Done"
                            ReturnCommand="{Binding SubmitCommand}"
                            Text="{Binding Password}"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="Password" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsRegisterMode}">
                    <Label Style="{StaticResource FieldLabel}" Text="Password" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry
                            Placeholder="At least 6 characters"
                            IsPassword="True"
                            ReturnType="Next"
                            Text="{Binding Password}"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="Password" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsRegisterMode}">
                    <Label Style="{StaticResource FieldLabel}" Text="Confirm password" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry
                            Placeholder="Repeat your password"
                            IsPassword="True"
                            ReturnType="Done"
                            ReturnCommand="{Binding SubmitCommand}"
                            Text="{Binding ConfirmPassword}"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="Confirm password" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}" Margin="0,18,0,0">
                <Label Style="{StaticResource ErrorBannerText}" Text="{Binding ErrorMessage}" />
            </Border>

            <!-- The one main button, with clear space above it -->
            <Button
                Text="{Binding SubmitText}"
                Command="{Binding SubmitCommand}"
                IsEnabled="{Binding IsNotBusy}"
                Margin="0,32,0,0" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                Margin="0,16,0,0" />

            <!-- Switch between the two modes with a text link, not a button -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="0"
                Margin="0,20,0,0"
                IsVisible="{Binding IsSignInMode}">
                <Label Style="{StaticResource Greeting}" Text="New here?" VerticalOptions="Center" />
                <Button
                    Style="{StaticResource LinkButton}"
                    Text="Create account"
                    Command="{Binding ShowRegisterCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    MinimumHeightRequest="44" />
            </HorizontalStackLayout>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="0"
                Margin="0,20,0,0"
                IsVisible="{Binding IsRegisterMode}">
                <Label Style="{StaticResource Greeting}" Text="Already have an account?" VerticalOptions="Center" />
                <Button
                    Style="{StaticResource LinkButton}"
                    Text="Sign in"
                    Command="{Binding ShowSignInCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    MinimumHeightRequest="44" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
